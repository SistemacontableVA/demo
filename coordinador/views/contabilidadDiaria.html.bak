<script src="../../assets/js/api-config.js"></script>
<script src="../../assets/js/empresa-brand.js"></script>
<script src="../../assets/js/utils.js"></script>
<script src="../../administracion/services/promotoresService.js"></script>
<script src="../../coordinador/services/contabilidadDiariaService.js"></script>
<script>
  const contabilidadPromotores = [];
  const CONTABILIDAD_DRAFT_KEY = 'contabilidad_diaria_draft_v1';

  function syncUrlContabilidad() {
    const defaultUrl = 'https://script.google.com/macros/s/AKfycbxeNcVqxyVVKPDAWFjj1IQjx8O--o5tPwOL7OP0R5lPX5tDWD1cOlMAMARQl0DKL0Otgg/exec';
    const configUrl = window.ApiConfig && window.ApiConfig.contabilidad && window.ApiConfig.contabilidad.baseUrl
      ? window.ApiConfig.contabilidad.baseUrl
      : defaultUrl;
    const localUrl = (() => {
      try {
        return localStorage.getItem('ks_contabilidad_gas_url') || '';
      } catch (error) {
        return '';
      }
    })();
    const apiUrl = (window.API_URL_CONTABILIDAD || configUrl || localUrl || defaultUrl).replace(/\/$/, '');

    if (apiUrl && (!window.API_URL_CONTABILIDAD || window.API_URL_CONTABILIDAD !== apiUrl)) {
      window.API_URL_CONTABILIDAD = apiUrl;
    }

    if (!window.API_URL_CONTABILIDAD) {
      window.API_URL_CONTABILIDAD = defaultUrl;
    }

    return window.API_URL_CONTABILIDAD || '';
  }

  function obtenerSnapshotContabilidad() {
    const filas = [];
    const fechaInput = document.getElementById('global-fecha') || document.getElementById('global-fecha-print');
    const municipioInput = document.getElementById('global-municipio') || document.getElementById('global-municipio-print');
    const coordinadorInput = document.getElementById('global-coordinador') || document.getElementById('global-coordinador-print');

    document.querySelectorAll('#tbody-afiliaciones tr').forEach(function (tr) {
      const selectorAsesor = tr.querySelector('.select-asesor');
      const nombreAsesor = selectorAsesor
        ? ((selectorAsesor.value || (selectorAsesor.selectedOptions[0] && selectorAsesor.selectedOptions[0].textContent) || '').trim())
        : '';
      const fila = {
        asesor: nombreAsesor,
        rol: tr.querySelector('.select-rol') ? tr.querySelector('.select-rol').value : 'PROMOTOR',
        aff: parseFloat(tr.querySelector('.input-aff')?.value || 0) || 0,
        recAbono: parseFloat(tr.querySelector('.input-rec-abono')?.value || 0) || 0,
        almuerzo: parseFloat(tr.querySelector('.input-almuerzo')?.value || 0) || 0,
        cena: parseFloat(tr.querySelector('.input-cena')?.value || 0) || 0,
        urbano: parseFloat(tr.querySelector('.input-urbano')?.value || 0) || 0,
        vereda: parseFloat(tr.querySelector('.input-vereda')?.value || 0) || 0,
        adic: parseFloat(tr.querySelector('.input-abono-adic')?.value || 0) || 0,
        ganado: parseFloat(tr.querySelector('.input-abono-ganado')?.value || 0) || 0,
        recaudoNeto: parseFloat(tr.querySelector('.input-recaudo-neto')?.value || 0) || 0,
        prestamo: parseFloat(tr.querySelector('.input-prestamo')?.value || 0) || 0
      };
      filas.push(fila);
    });

    return {
      id: 'jornada-' + (fechaInput?.value || Date.now()),
      fecha: fechaInput?.value || '',
      municipio: municipioInput?.value || '',
      coordinador: coordinadorInput?.value || '',
      estado: 'borrador',
      sincronizado: false,
      actualizadoEn: new Date().toISOString(),
      afiliaciones: filas,
      gastos: {
        comidaCoor: parseFloat(document.getElementById('gasto-comida-coor')?.value || 0) || 0,
        desayunos: parseFloat(document.getElementById('gasto-desayunos')?.value || 0) || 0,
        almuerzos: parseFloat(document.getElementById('gasto-almuerzos')?.value || 0) || 0,
        cenasGanadas: parseFloat(document.getElementById('gasto-cenas-ganadas')?.value || 0) || 0,
        cenasPrestadas: parseFloat(document.getElementById('gasto-cenas-prestadas')?.value || 0) || 0,
        hotel: parseFloat(document.getElementById('gasto-hotel')?.value || 0) || 0,
        transUrbano: parseFloat(document.getElementById('gasto-trans-urbano')?.value || 0) || 0,
        transVereda: parseFloat(document.getElementById('gasto-trans-vereda')?.value || 0) || 0,
        varios: parseFloat(document.getElementById('gasto-varios')?.value || 0) || 0,
        consignaciones: parseFloat(document.getElementById('gasto-consignaciones')?.value || 0) || 0,
        abonosGanados: parseFloat(document.getElementById('gasto-abonos-ganados')?.value || 0) || 0,
        giros: parseFloat(document.getElementById('ingreso-giros')?.value || 0) || 0,
        recaudoBase: parseFloat(document.getElementById('ingreso-recaudo-base')?.value || 0) || 0,
        abonosAdic: parseFloat(document.getElementById('ingreso-abonos-adic')?.value || 0) || 0,
        extra: Array.from(document.querySelectorAll('.extra-expense-row')).map(function (row) {
          return {
            numero: row.querySelector('.extra-expense-label')?.textContent || '',
            monto: parseFloat(row.querySelector('.expense-amount')?.value || 0) || 0,
            detalle: row.querySelector('.expense-description')?.value || ''
          };
        })
      },
      detalle: {
        saldoInicialOrigen: document.getElementById('saldo-inicial-origen')?.value || '',
        comidaCoordinador: document.getElementById('gasto-comida-coor-detalle')?.value || '',
        desayunos: document.getElementById('gasto-desayunos-detalle')?.value || '',
        varios: document.getElementById('gasto-varios-detalle')?.value || '',
        hotel: {
          moneda: document.getElementById('hotel-moneda')?.value || 'BS',
          monto: parseFloat(document.getElementById('hotel-monto-input')?.value || 0) || 0,
          tasa: parseFloat(document.getElementById('hotel-tasa')?.value || 0) || 0
        },
        consignaciones: {
          moneda: document.getElementById('consig-moneda')?.value || 'BS',
          monto: parseFloat(document.getElementById('consig-monto-input')?.value || 0) || 0,
          tasa: parseFloat(document.getElementById('consig-tasa')?.value || 0) || 0
        },
        giros: {
          moneda: document.getElementById('giros-moneda')?.value || 'BS',
          monto: parseFloat(document.getElementById('giros-monto-input')?.value || 0) || 0,
          tasa: parseFloat(document.getElementById('giros-tasa')?.value || 0) || 0
        }
      },
      totales: {
        totalIngresos: parseFloat(document.getElementById('total-ingresos')?.value || 0) || 0,
        totalDeduccion: parseFloat(document.getElementById('total-deduccion')?.value || 0) || 0,
        totalEgresos: parseFloat(document.getElementById('total-egresos')?.value || 0) || 0,
        saldoInicial: parseFloat(document.getElementById('coor-saldo-inicial')?.value || 0) || 0
      }
    };
  }

  function mostrarEstadoContabilidad(mensaje, tipo = 'info') {
    const modal = document.getElementById('modal-estado-contabilidad');
    const texto = document.getElementById('modal-estado-texto');
    const titulo = document.getElementById('modal-estado-title');
    if (!modal || !texto || !titulo) return;

    titulo.textContent = tipo === 'success' ? 'Guardado correctamente' : (tipo === 'error' ? 'No se pudo guardar' : 'Procesando');
    texto.textContent = mensaje;

    modal.classList.remove('hidden');
    modal.classList.add('visible');
    modal.style.display = 'flex';
    modal.style.opacity = '1';
    modal.style.visibility = 'visible';
    modal.style.pointerEvents = 'auto';
    modal.setAttribute('aria-hidden', 'false');
  }

  function ocultarEstadoContabilidad() {
    const modal = document.getElementById('modal-estado-contabilidad');
    if (!modal) return;

    modal.classList.remove('visible');
    modal.classList.add('hidden');
    modal.style.display = 'none';
    modal.style.opacity = '0';
    modal.style.visibility = 'hidden';
    modal.style.pointerEvents = 'none';
    modal.setAttribute('aria-hidden', 'true');
  }

  function actualizarEstadoDraftContabilidad(texto) {
    const estado = document.getElementById('estado-draft-contabilidad');
    if (estado && texto) {
      estado.value = texto;
    }
  }

  function obtenerResumenCierreContabilidad() {
    const draft = obtenerSnapshotContabilidad();
    const totalAfiliaciones = Array.isArray(draft.afiliaciones) ? draft.afiliaciones.length : 0;
    const totalIngresos = Number(draft.totales && draft.totales.totalIngresos) || 0;
    const totalEgresos = Number(draft.totales && draft.totales.totalEgresos) || 0;
    const totalDeduccion = Number(draft.totales && draft.totales.totalDeduccion) || 0;
    const saldoInicial = Number(draft.totales && draft.totales.saldoInicial) || 0;
    const saldoFinal = saldoInicial + totalIngresos - totalDeduccion - totalEgresos;

    return {
      fecha: draft.fecha || '',
      municipio: draft.municipio || '',
      coordinador: draft.coordinador || '',
      estado: draft.estado || 'borrador',
      totalAfiliaciones: totalAfiliaciones,
      totalIngresos: totalIngresos,
      totalEgresos: totalEgresos,
      totalDeduccion: totalDeduccion,
      saldoInicial: saldoInicial,
      saldoFinal: saldoFinal
    };
  }

  function renderResumenCierreContabilidad() {
    const resumen = obtenerResumenCierreContabilidad();
    const estadoResumen = document.getElementById('estado-jornada-resumen');
    const totalAfiliaciones = document.getElementById('resumen-total-afiliaciones');
    const saldoFinal = document.getElementById('resumen-saldo-final');

    if (estadoResumen) {
      const label = resumen.estado === 'validada' ? 'Validada' : (resumen.estado === 'cerrada' ? 'Cerrada' : 'Borrador');
      estadoResumen.textContent = label;
    }
    if (totalAfiliaciones) totalAfiliaciones.textContent = String(resumen.totalAfiliaciones || 0);
    if (saldoFinal) saldoFinal.textContent = '$' + Number(resumen.saldoFinal || 0).toLocaleString('es-VE', { maximumFractionDigits: 2 });
  }

  function mostrarReporteCierreContabilidad() {
    const resumen = obtenerResumenCierreContabilidad();
    const contenedor = document.getElementById('contenido-reporte-cierre-contabilidad');
    const modal = document.getElementById('modal-reporte-cierre-contabilidad');
    if (!contenedor || !modal) return;

    contenedor.innerHTML = `
      <div style="display:flex; flex-direction:column; gap:0.75rem;">
        <div style="border:1px solid #dfe7f1; background:#f8fafc; border-radius:12px; padding:0.8rem;">
          <div style="font-size:0.72rem; text-transform:uppercase; letter-spacing:0.08em; color:#475569; font-weight:700;">Jornada</div>
          <div style="margin-top:0.35rem; font-weight:700;">${resumen.fecha || 'Sin fecha'} · ${resumen.municipio || 'Sin municipio'} · ${resumen.coordinador || 'Sin coordinador'}</div>
        </div>
        <div style="display:grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap:0.75rem;">
          <div style="border:1px solid #dfe7f1; border-radius:10px; padding:0.7rem; background:#fff;">
            <div style="font-size:0.7rem; text-transform:uppercase; letter-spacing:0.08em; color:#64748b;">Estado</div>
            <div style="margin-top:0.3rem; font-weight:700;">${resumen.estado === 'cerrada' ? 'Cerrada' : (resumen.estado === 'validada' ? 'Validada' : 'Borrador')}</div>
          </div>
          <div style="border:1px solid #dfe7f1; border-radius:10px; padding:0.7rem; background:#fff;">
            <div style="font-size:0.7rem; text-transform:uppercase; letter-spacing:0.08em; color:#64748b;">Total afiliaciones</div>
            <div style="margin-top:0.3rem; font-weight:700;">${resumen.totalAfiliaciones}</div>
          </div>
          <div style="border:1px solid #dfe7f1; border-radius:10px; padding:0.7rem; background:#fff;">
            <div style="font-size:0.7rem; text-transform:uppercase; letter-spacing:0.08em; color:#64748b;">Ingresos</div>
            <div style="margin-top:0.3rem; font-weight:700;">$${Number(resumen.totalIngresos || 0).toLocaleString('es-VE', { maximumFractionDigits: 2 })}</div>
          </div>
          <div style="border:1px solid #dfe7f1; border-radius:10px; padding:0.7rem; background:#fff;">
            <div style="font-size:0.7rem; text-transform:uppercase; letter-spacing:0.08em; color:#64748b;">Egresos</div>
            <div style="margin-top:0.3rem; font-weight:700;">$${Number(resumen.totalEgresos || 0).toLocaleString('es-VE', { maximumFractionDigits: 2 })}</div>
          </div>
          <div style="border:1px solid #dfe7f1; border-radius:10px; padding:0.7rem; background:#fff;">
            <div style="font-size:0.7rem; text-transform:uppercase; letter-spacing:0.08em; color:#64748b;">Deducción</div>
            <div style="margin-top:0.3rem; font-weight:700;">$${Number(resumen.totalDeduccion || 0).toLocaleString('es-VE', { maximumFractionDigits: 2 })}</div>
          </div>
          <div style="border:1px solid #dfe7f1; border-radius:10px; padding:0.7rem; background:#fff;">
            <div style="font-size:0.7rem; text-transform:uppercase; letter-spacing:0.08em; color:#64748b;">Saldo final</div>
            <div style="margin-top:0.3rem; font-weight:700;">$${Number(resumen.saldoFinal || 0).toLocaleString('es-VE', { maximumFractionDigits: 2 })}</div>
          </div>
        </div>
      </div>
    `;

    modal.classList.remove('hidden');
    modal.classList.add('visible');
    modal.style.display = 'flex';
    modal.style.opacity = '1';
    modal.style.visibility = 'visible';
    modal.style.pointerEvents = 'auto';
    modal.setAttribute('aria-hidden', 'false');
  }

  function mostrarConfirmacionCierreContabilidad() {
    const draft = obtenerSnapshotContabilidad();
    if (!draft.fecha || !draft.municipio || !draft.coordinador) {
      mostrarEstadoContabilidad('Completa la fecha, municipio y coordinador antes de cerrar la contabilidad.', 'error');
      setTimeout(ocultarEstadoContabilidad, 1500);
      return;
    }

    mostrarReporteCierreContabilidad();
  }

  function cerrarReporteCierreContabilidad() {
    const modal = document.getElementById('modal-reporte-cierre-contabilidad');
    if (!modal) return;
    modal.classList.remove('visible');
    modal.classList.add('hidden');
    modal.style.display = 'none';
    modal.style.opacity = '0';
    modal.style.visibility = 'hidden';
    modal.style.pointerEvents = 'none';
    modal.setAttribute('aria-hidden', 'true');
  }

  function validarCierreContabilidad() {
    const draft = obtenerSnapshotContabilidad();
    if (!draft.fecha || !draft.municipio || !draft.coordinador) {
      mostrarEstadoContabilidad('Completa la fecha, municipio y coordinador antes de validar el cierre.', 'error');
      setTimeout(ocultarEstadoContabilidad, 1500);
      return { ok: false, error: 'Faltan metadatos de la jornada.' };
    }

    const resumen = obtenerResumenCierreContabilidad();
    draft.estado = 'pendiente_de_validacion';
    draft.actualizadoEn = new Date().toISOString();
    draft.totales = draft.totales || {};
    draft.totales.totalIngresos = resumen.totalIngresos;
    draft.totales.totalDeduccion = resumen.totalDeduccion;
    draft.totales.totalEgresos = resumen.totalEgresos;
    draft.totales.saldoInicial = resumen.saldoInicial;
    draft.totales.saldoFinal = resumen.saldoFinal;

    const result = window.ContabilidadDiariaService && typeof window.ContabilidadDiariaService.saveDraft === 'function'
      ? window.ContabilidadDiariaService.saveDraft(draft)
      : { ok: true, draft: draft };

    if (result && result.ok) {
      actualizarEstadoDraftContabilidad('Pendiente de validación');
      renderResumenCierreContabilidad();
      mostrarEstadoContabilidad('El cierre quedó pendiente de validación administrativa.', 'info');
      setTimeout(ocultarEstadoContabilidad, 1200);
      return { ok: true, draft: draft };
    }

    return { ok: false, error: 'No se pudo guardar la validación del cierre.' };
  }

  function cerrarContabilidad() {
    const draft = obtenerSnapshotContabilidad();
    if (!draft.fecha || !draft.municipio || !draft.coordinador) {
      mostrarEstadoContabilidad('Completa la fecha, municipio y coordinador antes de cerrar la contabilidad.', 'error');
      setTimeout(ocultarEstadoContabilidad, 1500);
      return { ok: false, error: 'Faltan metadatos de la jornada.' };
    }

    const validado = validarCierreContabilidad();
    if (!validado.ok) return validado;

    const draftCerrado = obtenerSnapshotContabilidad();
    draftCerrado.estado = 'cerrada';
    draftCerrado.actualizadoEn = new Date().toISOString();
    const result = window.ContabilidadDiariaService && typeof window.ContabilidadDiariaService.saveDraft === 'function'
      ? window.ContabilidadDiariaService.saveDraft(draftCerrado)
      : { ok: true, draft: draftCerrado };

    if (result && result.ok) {
      actualizarEstadoDraftContabilidad('Cerrada');
      renderResumenCierreContabilidad();
      cerrarReporteCierreContabilidad();
      mostrarEstadoContabilidad('Contabilidad cerrada localmente. Sincronizando el cierre con Google Sheets...', 'info');
      const sincronizacion = window.ContabilidadDiariaService && typeof window.ContabilidadDiariaService.syncDraft === 'function'
        ? window.ContabilidadDiariaService.syncDraft(draftCerrado)
        : Promise.resolve({ ok: true });
      Promise.resolve(sincronizacion).then(function (respuesta) {
        mostrarEstadoContabilidad(respuesta && respuesta.ok
          ? 'Contabilidad cerrada correctamente. El administrador ya puede revisarla.'
          : 'Contabilidad cerrada localmente. Quedó pendiente de sincronización.', respuesta && respuesta.ok ? 'success' : 'info');
        setTimeout(ocultarEstadoContabilidad, 1600);
      });
      return { ok: true, draft: draftCerrado };
    }

    mostrarEstadoContabilidad('No se pudo cerrar la contabilidad.', 'error');
    setTimeout(ocultarEstadoContabilidad, 1400);
    return { ok: false, error: 'No se pudo cerrar la contabilidad.' };
  }

  function guardarBorradorContabilidad(mostrarFeedback = true) {
    if (!window.ContabilidadDiariaService) {
      return { ok: false, error: 'Servicio de borrador no disponible.' };
    }

    const draft = obtenerSnapshotContabilidad();
    if (!draft.fecha || !draft.municipio || !draft.coordinador) {
      if (mostrarFeedback) {
        mostrarEstadoContabilidad('Completa fecha, municipio y coordinador antes de guardar.', 'error');
        setTimeout(ocultarEstadoContabilidad, 1500);
      } else {
        actualizarEstadoDraftContabilidad('Faltan datos');
      }
      return { ok: false, error: 'Faltan datos obligatorios del borrador.' };
    }

    const result = window.ContabilidadDiariaService.saveDraft(draft);

    if (result && result.ok) {
      const estadoActual = (draft.estado === 'cerrada' || draft.estado === 'pendiente_de_validacion' || draft.estado === 'validada') ? draft.estado : 'Autoguardado';
      actualizarEstadoDraftContabilidad(estadoActual === 'Autoguardado' ? 'Autoguardado' : estadoActual);
      renderResumenCierreContabilidad();
      if (mostrarFeedback) {
        mostrarEstadoContabilidad('Borrador guardado localmente. Se mantiene autoguardado.', 'success');
        setTimeout(ocultarEstadoContabilidad, 850);
      }
    }

    return result;
  }

  function guardarYSincronizarContabilidad() {
    if (!window.ContabilidadDiariaService) {
      return { ok: false, error: 'Servicio de borrador no disponible.' };
    }

    const draft = obtenerSnapshotContabilidad();
    if (!draft.fecha || !draft.municipio || !draft.coordinador) {
      mostrarEstadoContabilidad('Completa fecha, municipio y coordinador antes de sincronizar.', 'error');
      setTimeout(ocultarEstadoContabilidad, 1500);
      return { ok: false, error: 'Faltan datos obligatorios del borrador.' };
    }

    mostrarEstadoContabilidad('Guardando borrador en Google Sheets...', 'info');

    const result = window.ContabilidadDiariaService.syncDraft(draft);

    if (result && typeof result.then === 'function') {
      return result.then(function (respuesta) {
        const estado = document.getElementById('estado-draft-contabilidad');
        if (estado) {
          estado.value = respuesta && respuesta.ok ? 'Sincronizado con Google Sheets' : 'Guardado localmente. Pendiente de sincronización';
        }
        mostrarEstadoContabilidad(respuesta && respuesta.ok ? 'Borrador sincronizado con Google Sheets.' : 'Guardado localmente. Pendiente de sincronización.', respuesta && respuesta.ok ? 'success' : 'info');
        setTimeout(ocultarEstadoContabilidad, 1200);
        return respuesta;
      });
    }

    const estado = document.getElementById('estado-draft-contabilidad');
    if (estado) {
      estado.value = result && result.ok ? 'Sincronizado con Google Sheets' : 'Guardado localmente. Pendiente de sincronización';
    }
    mostrarEstadoContabilidad(result && result.ok ? 'Borrador sincronizado con Google Sheets.' : 'Guardado localmente. Pendiente de sincronización.', result && result.ok ? 'success' : 'info');
    setTimeout(ocultarEstadoContabilidad, 1200);
    return result;
  }

  function formatDateInputValue(value) {
    if (!value) return '';
    if (typeof value !== 'string') value = String(value);

    if (/^\d{4}-\d{2}-\d{2}$/.test(value)) return value;

    const fecha = new Date(value);
    if (Number.isNaN(fecha.getTime())) return value;

    const year = fecha.getFullYear();
    const month = String(fecha.getMonth() + 1).padStart(2, '0');
    const day = String(fecha.getDate()).padStart(2, '0');
    return year + '-' + month + '-' + day;
  }

  function normalizarFechaSeleccionada(value) {
    return formatDateInputValue(value);
  }

  function restaurarBorradorContabilidad(draftOverride = null) {
    if (!window.ContabilidadDiariaService) return false;

    const draft = draftOverride || window.ContabilidadDiariaService.loadDraft();
    if (!draft) return false;

    const metaCampos = [
      ['global-fecha', formatDateInputValue(draft.fecha || '')],
      ['global-municipio', draft.municipio || ''],
      ['global-coordinador', draft.coordinador || '']
    ];

    metaCampos.forEach(function ([id, value]) {
      const el = document.getElementById(id);
      if (el) el.value = value;
    });

    const tbody = document.getElementById('tbody-afiliaciones');
    if (tbody) {
      tbody.innerHTML = '';
      if (Array.isArray(draft.afiliaciones) && draft.afiliaciones.length) {
        draft.afiliaciones.forEach(function (filaDatos) {
          agregarFilaAfiliacion(filaDatos);
        });
      } else {
        agregarFilaAfiliacion();
      }
    }

    const gastos = (draft.gastos && typeof draft.gastos === 'object' && !Array.isArray(draft.gastos)) ? draft.gastos : {};
    const camposGastos = [
      ['gasto-comida-coor', gastos.comidaCoor],
      ['gasto-desayunos', gastos.desayunos],
      ['gasto-almuerzos', gastos.almuerzos],
      ['gasto-cenas-ganadas', gastos.cenasGanadas],
      ['gasto-cenas-prestadas', gastos.cenasPrestadas],
      ['gasto-hotel', gastos.hotel],
      ['gasto-trans-urbano', gastos.transUrbano],
      ['gasto-trans-vereda', gastos.transVereda],
      ['gasto-varios', gastos.varios],
      ['gasto-consignaciones', gastos.consignaciones],
      ['gasto-abonos-ganados', gastos.abonosGanados],
      ['ingreso-giros', gastos.giros],
      ['ingreso-recaudo-base', gastos.recaudoBase],
      ['ingreso-abonos-adic', gastos.abonosAdic],
      ['coor-saldo-inicial', gastos.saldoInicial],
      ['total-ingresos', gastos.totalIngresos],
      ['total-deduccion', gastos.totalDeduccion],
      ['total-egresos', gastos.totalEgresos]
    ];

    camposGastos.forEach(function ([id, value]) {
      const el = document.getElementById(id);
      if (el && value !== undefined && value !== null && value !== '') {
        el.value = value;
      }
    });

    const totales = (draft.totales && typeof draft.totales === 'object' && !Array.isArray(draft.totales)) ? draft.totales : {};
    if (totales.saldoInicial !== undefined) document.getElementById('coor-saldo-inicial').value = totales.saldoInicial;
    if (totales.totalIngresos !== undefined) document.getElementById('total-ingresos').value = totales.totalIngresos;
    if (totales.totalDeduccion !== undefined) document.getElementById('total-deduccion').value = totales.totalDeduccion;
    if (totales.totalEgresos !== undefined) document.getElementById('total-egresos').value = totales.totalEgresos;

    if (Array.isArray(gastos.extra) && gastos.extra.length) {
      const contenedor = document.getElementById('extra-expenses');
      if (contenedor) {
        contenedor.querySelectorAll('.extra-expense-row').forEach(function (fila) { fila.remove(); });
        gastos.extra.forEach(function (item, index) {
          const monto = item && typeof item === 'object' ? item.monto : item;
          const detalle = item && typeof item === 'object' ? item.detalle : '';
          if (index === 0) {
            document.getElementById('gasto-varios').value = monto;
            const detalleVarios = document.querySelector('#gasto-varios')?.parentElement?.querySelector('input[type="text"]');
            if (detalleVarios) detalleVarios.value = detalle || '';
          } else {
            agregarGastoExtra();
            const row = contenedor.querySelectorAll('.extra-expense-row')[index - 1];
            if (row) {
              const input = row.querySelector('.expense-amount');
              if (input) input.value = monto;
              const descripcion = row.querySelector('.expense-description');
              if (descripcion) descripcion.value = detalle || '';
            }
          }
        });
      }
    }

    const detalle = draft.detalle || (gastos && gastos.detalle) || {};
    const camposDetalle = [
      ['saldo-inicial-origen', detalle.saldoInicialOrigen],
      ['gasto-comida-coor-detalle', detalle.comidaCoordinador],
      ['gasto-desayunos-detalle', detalle.desayunos],
      ['gasto-varios-detalle', detalle.varios]
    ];
    camposDetalle.forEach(function ([id, value]) {
      const campo = document.getElementById(id);
      if (campo && value !== undefined && value !== null) campo.value = value;
    });
    const aplicarMovimiento = function (prefijo, movimiento) {
      if (!movimiento) return;
      const moneda = document.getElementById(prefijo + '-moneda');
      const monto = document.getElementById(prefijo + '-monto-input');
      const tasa = document.getElementById(prefijo + '-tasa');
      if (moneda && movimiento.moneda) moneda.value = movimiento.moneda;
      if (monto && movimiento.monto !== undefined) monto.value = movimiento.monto;
      if (tasa && movimiento.tasa !== undefined) tasa.value = movimiento.tasa;
    };
    aplicarMovimiento('hotel', detalle.hotel);
    aplicarMovimiento('consig', detalle.consignaciones);
    aplicarMovimiento('giros', detalle.giros);
    if (typeof toggleMonedaHotel === 'function') toggleMonedaHotel();
    if (typeof toggleMonedaConsig === 'function') toggleMonedaConsig();
    if (typeof toggleMonedaGiros === 'function') toggleMonedaGiros();

    recalcularTodo();
    renderResumenCierreContabilidad();
    return true;
  }

  function registrarAutosaveContabilidad() {
    const campos = document.querySelectorAll('#tab-contabilidad input, #tab-contabilidad select');

    if (!campos.length) return;

    const alreadyBound = document.body.dataset.contabilidadAutosaveBound === 'true';
    if (alreadyBound) return;
    document.body.dataset.contabilidadAutosaveBound = 'true';

    campos.forEach(function (campo) {
      if (campo.dataset.contabilidadAutosaveBound === 'true') return;
      campo.dataset.contabilidadAutosaveBound = 'true';

      let timerAutosave = null;
      const dispararAutosave = function () {
        if (timerAutosave) clearTimeout(timerAutosave);
        timerAutosave = setTimeout(function () {
          actualizarEstadoDraftContabilidad('Guardando...');
          guardarBorradorContabilidad(false);
        }, 250);
      };

      campo.addEventListener('input', dispararAutosave);
      campo.addEventListener('change', dispararAutosave);
    });
  }

  function obtenerBaseApiContabilidad() {
    const contextos = [window.parent, window.top, window].filter(Boolean);
    for (const contexto of contextos) {
      if (contexto && contexto.API_URL_CONTABILIDAD && typeof contexto.API_URL_CONTABILIDAD === 'string') {
        return contexto.API_URL_CONTABILIDAD.replace(/\/$/, '');
      }
      if (contexto && contexto.ApiConfig && contexto.ApiConfig.contabilidad && contexto.ApiConfig.contabilidad.baseUrl) {
        return contexto.ApiConfig.contabilidad.baseUrl.replace(/\/$/, '');
      }
      try {
        if (contexto && contexto.localStorage) {
          const gasUrl = contexto.localStorage.getItem('ks_contabilidad_gas_url') || contexto.localStorage.getItem('ks_lic_gasurl');
          if (gasUrl) return gasUrl.replace(/\/$/, '');
        }
      } catch (e) {
        // Ignorar errores de acceso a localStorage
      }
    }
    return '';
  }

  function obtenerPromotoresContabilidad() {
    const contextos = [window.parent, window.top, window].filter(Boolean);

    for (const contexto of contextos) {
      if (!contexto) continue;
      const servicio = contexto.PromotoresService;
      if (servicio && typeof servicio.getAll === 'function') {
        return servicio.getAll({ force: true });
      }
    }

    const baseUrl = obtenerBaseApiContabilidad();
    if (!baseUrl) {
      return Promise.resolve([]);
    }

    return fetch(baseUrl + '?action=listar-promotores', { cache: 'no-store' })
      .then(function (res) {
        if (!res.ok) throw new Error('HTTP ' + res.status);
        return res.json();
      })
      .then(function (payload) {
        if (!payload) return [];
        if (Array.isArray(payload)) return payload;
        if (Array.isArray(payload.promotores)) return payload.promotores;
        if (Array.isArray(payload.data)) return payload.data;
        return [];
      });
  }

  function buildPromotorOptions(selectedValue) {
    const placeholder = '<option value="">Seleccionar promotor</option>';
    const options = (contabilidadPromotores || []).map(function (promotor) {
      const nombre = (promotor && (promotor.nombre || promotor.promotor || '')).toString().trim();
      if (!nombre) return '';
      const selected = selectedValue && nombre === selectedValue ? ' selected' : '';
      return '<option value="' + nombre.replace(/"/g, '&quot;') + '"' + selected + '>' + nombre + '</option>';
    }).join('');
    return placeholder + options;
  }

  async function cargarPromotoresContabilidad() {
    try {
      const lista = await obtenerPromotoresContabilidad();
      contabilidadPromotores.length = 0;

      (lista || []).forEach(function (promotor) {
        const nombre = (promotor && (promotor.nombre || promotor.promotor || '')).toString().trim();
        if (nombre) contabilidadPromotores.push({ nombre: nombre });
      });

      document.querySelectorAll('.select-asesor').forEach(function (select) {
        const currentValue = select.value || '';
        select.innerHTML = buildPromotorOptions(currentValue);
      });
    } catch (error) {
      console.warn('[ContabilidadDiaria] No se pudieron cargar los promotores:', error && error.message ? error.message : error);
      document.querySelectorAll('.select-asesor').forEach(function (select) {
        select.innerHTML = '<option value="">No se pudo cargar</option>';
      });
    }
  }

  function mostrarModalReset() {
    const modal = document.getElementById('modal-reset');
    if (!modal) return;
    modal.classList.add('visible');
    modal.setAttribute('aria-hidden', 'false');
  }

  function cerrarModalReset() {
    const modal = document.getElementById('modal-reset');
    if (!modal) return;
    modal.classList.remove('visible');
    modal.setAttribute('aria-hidden', 'true');
  }

  function confirmarResetContabilidad() {
    cerrarModalReset();
    restablecerContabilidad();
  }

  async function mostrarModalBienvenidaContabilidad() {
    const modal = document.getElementById('modal-bienvenida-contabilidad');
    if (!modal) return;

    modal.classList.remove('hidden');
    modal.classList.add('visible');
    modal.style.display = 'flex';
    modal.style.opacity = '1';
    modal.style.visibility = 'visible';
    modal.style.pointerEvents = 'auto';
    modal.setAttribute('aria-hidden', 'false');
  }

  function cerrarModalBienvenidaContabilidad(continuar = true) {
    const modal = document.getElementById('modal-bienvenida-contabilidad');
    if (modal) {
      modal.classList.remove('visible');
      modal.classList.add('hidden');
      modal.style.display = 'none';
      modal.style.opacity = '0';
      modal.style.visibility = 'hidden';
      modal.style.pointerEvents = 'none';
      modal.setAttribute('aria-hidden', 'true');
    }

    if (!continuar) {
      restablecerContabilidad();
      if (!document.querySelector('.select-asesor')) {
        agregarFilaAfiliacion();
      }
    }

    cargarPromotoresContabilidad()
      .catch(function () {
        console.warn('[ContabilidadDiaria] No se pudo cargar la lista al continuar desde bienvenida.');
      })
      .finally(function () {
        recalcularTodo();
      });
  }

  function cerrarModalCargaBorradoresContabilidad(reabrirBienvenida = false) {
    const modal = document.getElementById('modal-cargar-borradores-contabilidad');
    if (modal) {
      modal.classList.remove('visible');
      modal.classList.add('hidden');
      modal.style.display = 'none';
      modal.style.opacity = '0';
      modal.style.visibility = 'hidden';
      modal.style.pointerEvents = 'none';
      modal.setAttribute('aria-hidden', 'true');
    }

    if (!reabrirBienvenida) return;

    const modalBienvenida = document.getElementById('modal-bienvenida-contabilidad');
    if (modalBienvenida) {
      modalBienvenida.classList.remove('hidden');
      modalBienvenida.classList.add('visible');
      modalBienvenida.style.display = 'flex';
      modalBienvenida.style.opacity = '1';
      modalBienvenida.style.visibility = 'visible';
      modalBienvenida.style.pointerEvents = 'auto';
      modalBienvenida.setAttribute('aria-hidden', 'false');
    }
  }

  async function abrirModalCargaBorradoresContabilidad() {
    const modalBienvenida = document.getElementById('modal-bienvenida-contabilidad');
    const modalCarga = document.getElementById('modal-cargar-borradores-contabilidad');
    const select = document.getElementById('select-borrador-contabilidad');
    const contenedor = document.getElementById('modal-borradores-contabilidad');
    const loading = document.getElementById('modal-borradores-loading');
    const confirmar = document.getElementById('btn-confirmar-carga-borrador');

    if (modalBienvenida) {
      modalBienvenida.classList.remove('visible');
      modalBienvenida.classList.add('hidden');
      modalBienvenida.style.display = 'none';
      modalBienvenida.style.opacity = '0';
      modalBienvenida.style.visibility = 'hidden';
      modalBienvenida.style.pointerEvents = 'none';
      modalBienvenida.setAttribute('aria-hidden', 'true');
    }

    if (select) {
      select.innerHTML = '<option value="">Selecciona una fecha para cargar</option>';
      select.classList.add('hidden');
    }
    if (confirmar) confirmar.classList.add('hidden');
    if (loading) loading.textContent = 'Estamos cargando los borradores dinámicamente...';
    if (contenedor) contenedor.classList.add('hidden');

    if (modalCarga) {
      modalCarga.classList.remove('hidden');
      modalCarga.classList.add('visible');
      modalCarga.style.display = 'flex';
      modalCarga.style.opacity = '1';
      modalCarga.style.visibility = 'visible';
      modalCarga.style.pointerEvents = 'auto';
      modalCarga.setAttribute('aria-hidden', 'false');
    }

    await cargarBorradorSeleccionadoContabilidad();
  }

  async function cargarBorradorSeleccionadoContabilidad() {
    const select = document.getElementById('select-borrador-contabilidad');
    const contenedor = document.getElementById('modal-borradores-contabilidad');
    const loading = document.getElementById('modal-borradores-loading');
    const confirmar = document.getElementById('btn-confirmar-carga-borrador');

    if (contenedor) contenedor.classList.remove('hidden');
    if (loading) loading.textContent = 'Estamos cargando los borradores dinámicamente...';
    if (confirmar) confirmar.classList.add('hidden');

    let fechas = [];
    try {
      if (window.ContabilidadDiariaService && typeof window.ContabilidadDiariaService.loadRemoteDraftHistory === 'function') {
        const history = await window.ContabilidadDiariaService.loadRemoteDraftHistory();
        fechas = (history || []).map(function (item) {
          const valor = item && (item.fecha || item.FECHA) ? String(item.fecha || item.FECHA) : '';
          return valor ? formatDateInputValue(valor) : '';
        }).filter(Boolean).sort(function (a, b) { return new Date(b) - new Date(a); });
      }
    } catch (error) {
      console.warn('[ContabilidadDiaria] No se pudo cargar historial de borradores desde Google Sheets:', error);
    }

    if (!fechas.length && window.ContabilidadDiariaService && typeof window.ContabilidadDiariaService.getDraftHistory === 'function') {
      const localHistory = window.ContabilidadDiariaService.getDraftHistory();
      fechas = Object.keys(localHistory || {}).map(function (valor) { return formatDateInputValue(valor); }).filter(Boolean).sort(function (a, b) { return new Date(b) - new Date(a); });
    }

    if (select) {
      const opciones = Array.from(new Set(fechas)).map(function (fecha) {
        return '<option value="' + fecha + '">' + fecha + '</option>';
      }).join('');
      select.innerHTML = '<option value="">Selecciona una fecha para cargar</option>' + opciones;

      if (fechas.length) {
        select.classList.remove('hidden');
        if (confirmar) confirmar.classList.remove('hidden');
        if (loading) loading.textContent = 'Borradores disponibles para cargar.';
      } else {
        select.classList.add('hidden');
        if (confirmar) confirmar.classList.add('hidden');
        if (loading) loading.textContent = 'No hay borradores guardados todavía. Puedes empezar uno nuevo.';
      }
    }
  }

  async function confirmarCargaBorradorSeleccionadoContabilidad() {
    const select = document.getElementById('select-borrador-contabilidad');
    const fechaSeleccionada = select ? select.value : '';
    const fecha = normalizarFechaSeleccionada(fechaSeleccionada);

    if (!fecha) {
      mostrarEstadoContabilidad('Selecciona una fecha antes de cargar.', 'info');
      setTimeout(ocultarEstadoContabilidad, 1200);
      return;
    }

    mostrarEstadoContabilidad('Cargando borrador de ' + fecha + '...', 'info');

    let draft = null;
    try {
      if (window.ContabilidadDiariaService && typeof window.ContabilidadDiariaService.loadRemoteDraftByFecha === 'function') {
        draft = await window.ContabilidadDiariaService.loadRemoteDraftByFecha(fecha);
      }

      if (!draft && window.ContabilidadDiariaService && typeof window.ContabilidadDiariaService.loadDraft === 'function') {
        draft = window.ContabilidadDiariaService.loadDraft(fecha);
      }

      if (!draft && window.ContabilidadDiariaService && typeof window.ContabilidadDiariaService.getDraftHistory === 'function') {
        const history = window.ContabilidadDiariaService.getDraftHistory();
        const match = Object.keys(history || {}).find(function (key) {
          return formatDateInputValue(key) === fecha;
        });
        if (match) {
          draft = window.ContabilidadDiariaService.loadDraft(match);
        }
      }
    } catch (error) {
      console.warn('[ContabilidadDiaria] Error al cargar el borrador seleccionado:', error);
    }

    if (!draft) {
      mostrarEstadoContabilidad('No se encontró el borrador seleccionado.', 'error');
      setTimeout(ocultarEstadoContabilidad, 1400);
      return;
    }

    const modal = document.getElementById('modal-bienvenida-contabilidad');
    if (modal) {
      modal.classList.remove('visible');
      modal.setAttribute('aria-hidden', 'true');
    }

    const modalCarga = document.getElementById('modal-cargar-borradores-contabilidad');
    if (modalCarga) {
      modalCarga.classList.remove('visible');
      modalCarga.classList.add('hidden');
      modalCarga.style.display = 'none';
      modalCarga.style.opacity = '0';
      modalCarga.style.visibility = 'hidden';
      modalCarga.style.pointerEvents = 'none';
      modalCarga.setAttribute('aria-hidden', 'true');
    }

    localStorage.setItem(CONTABILIDAD_DRAFT_KEY, JSON.stringify(draft));
    const serviceResult = window.ContabilidadDiariaService && typeof window.ContabilidadDiariaService.saveDraft === 'function'
      ? window.ContabilidadDiariaService.saveDraft(draft)
      : { ok: true };

    if (serviceResult && serviceResult.ok) {
      const tbody = document.getElementById('tbody-afiliaciones');
      if (tbody) tbody.innerHTML = '';
      const result = restaurarBorradorContabilidad(draft);
      if (!result) {
        const loaded = await window.ContabilidadDiariaService.loadRemoteDraftByFecha(fecha);
        if (loaded) {
          localStorage.setItem(CONTABILIDAD_DRAFT_KEY, JSON.stringify(loaded));
          restaurarBorradorContabilidad(loaded);
        }
      }
    }

    if (document.getElementById('estado-draft-contabilidad')) {
      document.getElementById('estado-draft-contabilidad').value = 'Borrador cargado';
    }

    mostrarEstadoContabilidad('Borrador cargado correctamente desde Google Sheets.', 'success');
    setTimeout(ocultarEstadoContabilidad, 1200);
  }

  function limpiarResumenContabilidad() {
    const textosResumen = [
      ['tot-aff', '0'],
      ['tot-rec-abono', '$0'],
      ['tot-almuerzo', '$0'],
      ['tot-cena', '$0'],
      ['tot-urbano', '$0'],
      ['tot-vereda', '$0'],
      ['tot-abono-adic', '$0'],
      ['tot-abono-ganado', '$0'],
      ['tot-recaudo-neto', '$0'],
      ['tot-prestamo', '$0'],
      ['card-tot-aff', '0'],
      ['card-tot-abono', '$0'],
      ['card-tot-almuerzo', '$0'],
      ['card-tot-neto', '$0'],
      ['card-coor-saldo-init', ''],
      ['card-coor-ingresos', ''],
      ['card-coor-gastos', ''],
      ['card-coor-saldo-final', ''],
      ['coor-saldo-final-big', ''],
      ['balance-detalle', '']
    ];

    textosResumen.forEach(([id, value]) => {
      const el = document.getElementById(id);
      if (el) el.innerText = value;
    });

    ['total-ingresos', 'total-deduccion', 'total-egresos', 'gasto-consignaciones', 'gasto-abonos-ganados', 'gasto-hotel', 'ingreso-giros', 'ingreso-cant-aff', 'ingreso-recaudo-base', 'ingreso-abonos-adic', 'gasto-almuerzos', 'gasto-cenas-ganadas', 'gasto-cenas-prestadas', 'gasto-comida-coor', 'gasto-desayunos', 'gasto-trans-urbano', 'gasto-trans-vereda', 'gasto-varios', 'coor-saldo-inicial'].forEach((id) => {
      const el = document.getElementById(id);
      if (el) el.value = '';
    });

    ['hotel-moneda', 'consig-moneda', 'giros-moneda'].forEach((id) => {
      const el = document.getElementById(id);
      if (el) el.selectedIndex = 0;
    });

    ['hotel-tasa', 'consig-tasa', 'giros-tasa'].forEach((id) => {
      const el = document.getElementById(id);
      if (el) {
        el.value = '0';
        el.disabled = true;
      }
    });
  }

  function restablecerContabilidad() {
    const tbody = document.getElementById('tbody-afiliaciones');
    if (tbody) {
      tbody.innerHTML = '';
    }

    const filasExtra = document.querySelectorAll('#extra-expenses .extra-expense-row');
    filasExtra.forEach(function (fila, index) {
      if (index >= 3) fila.remove();
      const inputMonto = fila.querySelector('.expense-amount');
      const inputDesc = fila.querySelector('.expense-description');
      if (inputMonto) inputMonto.value = '';
      if (inputDesc) inputDesc.value = '';
    });

    document.querySelectorAll('#tab-contabilidad input, #tab-contabilidad select').forEach(function (campo) {
      if (campo.tagName === 'SELECT') {
        campo.selectedIndex = 0;
        return;
      }
      if (campo.type === 'number' || campo.type === 'text' || campo.type === 'date') {
        campo.value = '';
      }
    });

    document.getElementById('global-fecha').value = '';
    document.getElementById('global-municipio').value = '';
    document.getElementById('global-coordinador').value = '';

    const estadoDraft = document.getElementById('estado-draft-contabilidad');
    if (estadoDraft) estadoDraft.value = 'Borrador local';

    limpiarResumenContabilidad();

    if (window.ContabilidadDiariaService) {
      window.ContabilidadDiariaService.clearDraft();
    }

    if (tbody) {
      const tr = document.createElement('tr');
      tr.innerHTML = `
        <td class="index-cell">1</td>
        <td>
          <select class="select-asesor">
            ${buildPromotorOptions('')}
          </select>
        </td>
        <td>
          <select class="select-rol">
            <option value="PROMOTOR" selected>Promotor</option>
            <option value="COORDINADOR">Coordinador</option>
          </select>
        </td>
        <td><input type="number" class="input-aff" value="" min="0" oninput="calcularFilaAfiliacion(this.closest('tr'))"></td>
        <td><input type="number" class="input-rec-abono" value="" oninput="calcularFilaAfiliacion(this.closest('tr'), true)"></td>
        <td><input type="number" class="input-almuerzo" value="" readonly></td>
        <td><input type="number" class="input-cena" value="" readonly></td>
        <td><input type="number" class="input-urbano" value="" oninput="calcularFilaAfiliacion(this.closest('tr'))"></td>
        <td><input type="number" class="input-vereda" value="" oninput="calcularFilaAfiliacion(this.closest('tr'))"></td>
        <td><input type="number" class="input-abono-adic" value="" oninput="calcularFilaAfiliacion(this.closest('tr'))"></td>
        <td><input type="number" class="input-abono-ganado" value="" oninput="calcularFilaAfiliacion(this.closest('tr'))"></td>
        <td><input type="number" class="input-recaudo-neto net-recaudo-cell" value="" readonly></td>
        <td><input type="number" class="input-prestamo" value="" oninput="recalcularTodo()"></td>
        <td><button class="btn btn-danger" onclick="eliminarFilaAfiliacion(this)">✕</button></td>
      `;
      tbody.appendChild(tr);
    }
  }

  async function intentarRestaurarBorradorRemoto() {
    if (!window.ContabilidadDiariaService || typeof window.ContabilidadDiariaService.loadRemoteDraftHistory !== 'function') {
      return false;
    }

    try {
      const history = await window.ContabilidadDiariaService.loadRemoteDraftHistory();
      const fechas = (history || [])
        .map(function (item) { return item && (item.fecha || item.FECHA) ? String(item.fecha || item.FECHA) : ''; })
        .filter(Boolean)
        .sort(function (a, b) { return new Date(b) - new Date(a); });

      if (!fechas.length) return false;

      const primerBorrador = await window.ContabilidadDiariaService.loadRemoteDraftByFecha(fechas[0]);
      if (!primerBorrador) return false;

      localStorage.setItem(CONTABILIDAD_DRAFT_KEY, JSON.stringify(primerBorrador));
      return restaurarBorradorContabilidad(primerBorrador);
    } catch (error) {
      console.warn('[ContabilidadDiaria] No se pudo restaurar borrador remoto:', error);
      return false;
    }
  }

  window.onload = function () {
    (async function () {
      syncUrlContabilidad();
      mostrarModalBienvenidaContabilidad();

      let draftRestaurado = await intentarRestaurarBorradorRemoto();

      if (!draftRestaurado) {
        const localHistory = window.ContabilidadDiariaService && typeof window.ContabilidadDiariaService.getDraftHistory === 'function'
          ? window.ContabilidadDiariaService.getDraftHistory()
          : {};
        const fechas = Object.keys(localHistory || {}).sort(function (a, b) { return new Date(b) - new Date(a); });

        if (fechas.length) {
          const localDraft = window.ContabilidadDiariaService ? window.ContabilidadDiariaService.loadDraft(fechas[0]) : null;
          if (localDraft) {
            draftRestaurado = restaurarBorradorContabilidad(localDraft);
          }
        }
      }

      if (draftRestaurado) {
        cerrarModalBienvenidaContabilidad(true);
      } else {
        agregarFilaAfiliacion();
      }

      renderResumenCierreContabilidad();
      registrarAutosaveContabilidad();
    })();
  };

  function switchTab(tabId, btn) {
    document.querySelectorAll('.tab-content').forEach(tc => tc.classList.remove('active'));
    document.querySelectorAll('.tab-btn').forEach(tb => tb.classList.remove('active'));
    document.getElementById(tabId).classList.add('active');
    btn.classList.add('active');
  }

  function agregarFilaAfiliacion(datos = null) {
    const tbody = document.getElementById('tbody-afiliaciones');
    if (!tbody) return;

    const index = tbody.children.length + 1;
    const tr = document.createElement('tr');
    const asesorSeleccionado = datos && datos.asesor ? datos.asesor : '';

    tr.innerHTML = `
      <td class="index-cell">${index}</td>
      <td>
        <select class="select-asesor" onchange="calcularFilaAfiliacion(this.closest('tr'))">
          ${buildPromotorOptions(asesorSeleccionado)}
        </select>
      </td>
      <td>
        <select class="select-rol" onchange="calcularFilaAfiliacion(this.closest('tr'))">
          <option value="PROMOTOR"    ${datos && datos.rol === 'PROMOTOR'    ? 'selected' : ''}>Promotor</option>
          <option value="COORDINADOR" ${datos && datos.rol === 'COORDINADOR' ? 'selected' : ''}>Coordinador</option>
        </select>
      </td>
      <td><input type="number" class="input-aff" value="${datos ? datos.aff    : ''}" min="0" oninput="calcularFilaAfiliacion(this.closest('tr'))"></td>
      <td><input type="number" class="input-rec-abono" value="${datos ? datos.recAbono : ''}" oninput="calcularFilaAfiliacion(this.closest('tr'), true)"></td>
      <td><input type="number" class="input-almuerzo" value="${datos ? datos.almuerzo : ''}" readonly></td>
      <td><input type="number" class="input-cena" value="${datos ? datos.cena : ''}" readonly></td>
      <td><input type="number" class="input-urbano" value="${datos ? datos.urbano  : ''}" oninput="calcularFilaAfiliacion(this.closest('tr'))"></td>
      <td><input type="number" class="input-vereda" value="${datos ? datos.vereda  : ''}" oninput="calcularFilaAfiliacion(this.closest('tr'))"></td>
      <td><input type="number" class="input-abono-adic" value="${datos ? datos.adic    : ''}" oninput="calcularFilaAfiliacion(this.closest('tr'))"></td>
      <td><input type="number" class="input-abono-ganado" value="${datos ? datos.ganado : ''}" oninput="calcularFilaAfiliacion(this.closest('tr'))"></td>
      <td><input type="number" class="input-recaudo-neto net-recaudo-cell" value="${datos ? datos.recaudoNeto : ''}" readonly></td>
      <td><input type="number" class="input-prestamo" value="${datos ? datos.prestamo : ''}" oninput="recalcularTodo()"></td>
      <td><button class="btn btn-danger" onclick="eliminarFilaAfiliacion(this)">✕</button></td>
    `;

    tbody.appendChild(tr);

    if (datos) {
      calcularFilaAfiliacion(tr);
    }
  }

  function eliminarFilaAfiliacion(btn) {
    btn.closest("tr").remove();
    recalcularTodo();
  }

  function calcularFilaAfiliacion(tr, recaudoManual = false) {
    const rol = tr.querySelector(".select-rol").value;
    const aff = parseInt(tr.querySelector(".input-aff").value) || 0;

    const inputRecAbono = tr.querySelector(".input-rec-abono");
    if (!recaudoManual) inputRecAbono.value = aff * 3;
    const recaudoAbono = parseFloat(inputRecAbono.value) || 0;

    const almuerzo = (rol === "PROMOTOR" && aff >= 1) ? 3 : 0;
    tr.querySelector(".input-almuerzo").value = almuerzo;

    const cena = (rol === "PROMOTOR" && aff >= 10) ? 3 : 0;
    tr.querySelector(".input-cena").value = cena;

    const urbano     = parseFloat(tr.querySelector(".input-urbano").value)      || 0;
    const vereda     = parseFloat(tr.querySelector(".input-vereda").value)      || 0;
    const abonoAdic  = parseFloat(tr.querySelector(".input-abono-adic").value)  || 0;
    const abonoGanado= parseFloat(tr.querySelector(".input-abono-ganado").value)|| 0;

    const recaudoNeto = (recaudoAbono + abonoAdic) - (almuerzo + cena + urbano + vereda + abonoGanado);
    tr.querySelector(".input-recaudo-neto").value = recaudoNeto;

    recalcularTodo();
  }

  function recalcularTodo() {
    let totAff=0, totRecAbono=0, totAlmuerzo=0, totCena=0;
    let totUrbano=0, totVereda=0, totAbonoAdic=0, totAbonoGanado=0;
    let totRecaudoNeto=0, totPrestamo=0;

    document.querySelectorAll("#tbody-afiliaciones tr").forEach(tr => {
      const alm = parseFloat(tr.querySelector(".input-almuerzo").value) || 0;
      totAff          += parseInt(tr.querySelector(".input-aff").value)         || 0;
      totRecAbono     += parseFloat(tr.querySelector(".input-rec-abono").value) || 0;
      totAlmuerzo     += alm;
      totCena         += parseFloat(tr.querySelector(".input-cena").value)      || 0;
      totUrbano       += parseFloat(tr.querySelector(".input-urbano").value)    || 0;
      totVereda       += parseFloat(tr.querySelector(".input-vereda").value)    || 0;
      totAbonoAdic    += parseFloat(tr.querySelector(".input-abono-adic").value)   || 0;
      totAbonoGanado  += parseFloat(tr.querySelector(".input-abono-ganado").value) || 0;
      totRecaudoNeto  += parseFloat(tr.querySelector(".input-recaudo-neto").value) || 0;
      totPrestamo     += parseFloat(tr.querySelector(".input-prestamo").value)  || 0;
    });

    // Totales tabla
    document.getElementById("tot-aff").innerText         = totAff;
    document.getElementById("tot-rec-abono").innerText   = "$" + totRecAbono;
    document.getElementById("tot-almuerzo").innerText    = "$" + totAlmuerzo;
    document.getElementById("tot-cena").innerText        = "$" + totCena;
    document.getElementById("tot-urbano").innerText      = "$" + totUrbano;
    document.getElementById("tot-vereda").innerText      = "$" + totVereda;
    document.getElementById("tot-abono-adic").innerText  = "$" + totAbonoAdic;
    document.getElementById("tot-abono-ganado").innerText= "$" + totAbonoGanado;
    document.getElementById("tot-recaudo-neto").innerText= "$" + totRecaudoNeto;
    document.getElementById("tot-prestamo").innerText    = "$" + totPrestamo;

    // Stat cards pestaña 1
    document.getElementById("card-tot-aff").innerText     = totAff;
    document.getElementById("card-tot-abono").innerText   = "$" + totRecAbono;
    document.getElementById("card-tot-almuerzo").innerText= "$" + totAlmuerzo;
    document.getElementById("card-tot-neto").innerText    = "$" + totRecaudoNeto;

    // Vinculación contabilidad
    document.getElementById("gasto-almuerzos").value       = totAlmuerzo;
    document.getElementById("gasto-cenas-ganadas").value   = totCena;
    document.getElementById("gasto-cenas-prestadas").value = totPrestamo;
    document.getElementById("gasto-abonos-ganados").value  = totAbonoGanado;
    document.getElementById("ingreso-cant-aff").value      = totAff;
    document.getElementById("ingreso-recaudo-base").value  = totRecAbono;
    document.getElementById("ingreso-abonos-adic").value   = totAbonoAdic;

    calcularContabilidad();
  }

  /* ── MONEDA DUAL: HOTEL ── */
  function toggleMonedaHotel() {
    const tasaInput = document.getElementById("hotel-tasa");
    const esBs = document.getElementById("hotel-moneda").value === "BS";
    tasaInput.disabled = !esBs;
    if (!esBs) tasaInput.value = 0;
    calcularHotel();
  }

  function calcularHotel() {
    const moneda = document.getElementById("hotel-moneda").value;
    const monto  = parseFloat(document.getElementById("hotel-monto-input").value) || 0;
    const tasa   = parseFloat(document.getElementById("hotel-tasa").value)        || 1;
    document.getElementById("gasto-hotel").value = (moneda === "BS" ? (tasa > 0 ? monto / tasa : 0) : monto).toFixed(2);
    calcularContabilidad();
  }

  /* ── MONEDA DUAL: CONSIGNACIONES ── */
  function toggleMonedaConsig() {
    const tasaInput = document.getElementById("consig-tasa");
    const esBs = document.getElementById("consig-moneda").value === "BS";
    tasaInput.disabled = !esBs;
    if (!esBs) tasaInput.value = 0;
    calcularConsig();
  }

  function calcularConsig() {
    const moneda = document.getElementById("consig-moneda").value;
    const monto  = parseFloat(document.getElementById("consig-monto-input").value) || 0;
    const tasa   = parseFloat(document.getElementById("consig-tasa").value)        || 1;
    document.getElementById("gasto-consignaciones").value = (moneda === "BS" ? (tasa > 0 ? monto / tasa : 0) : monto).toFixed(2);
    calcularContabilidad();
  }

  /* ── MONEDA DUAL: GIROS ── */
  function toggleMonedaGiros() {
    const tasaInput = document.getElementById("giros-tasa");
    const esBs = document.getElementById("giros-moneda").value === "BS";
    tasaInput.disabled = !esBs;
    if (!esBs) tasaInput.value = 0;
    calcularGiros();
  }

  function calcularGiros() {
    const moneda = document.getElementById("giros-moneda").value;
    const monto  = parseFloat(document.getElementById("giros-monto-input").value) || 0;
    const tasa   = parseFloat(document.getElementById("giros-tasa").value)        || 1;
    document.getElementById("ingreso-giros").value = (moneda === "BS" ? (tasa > 0 ? monto / tasa : 0) : monto).toFixed(2);
    calcularContabilidad();
  }

  function agregarGastoExtra() {
    const contenedor = document.getElementById("extra-expenses");
    const boton = contenedor.querySelector(".add-expense-button");
    const numero = contenedor.querySelectorAll(".extra-expense-row").length + 1;
    const fila = document.createElement("div");
    fila.className = "extra-expense-row";
    fila.innerHTML = `
      <span class="extra-expense-icon" aria-hidden="true">📦</span>
      <span class="extra-expense-label">Gasto ${numero}</span>
      <input class="expense-amount" type="number" placeholder="Monto ($)" oninput="calcularContabilidad()">
      <input class="expense-description" type="text" placeholder="Detalle del gasto">
    `;
    contenedor.insertBefore(fila, boton);
  }

  /* ── CONTABILIDAD PRINCIPAL ── */
  function calcularContabilidad() {
    const gastoComidaCoor = document.getElementById("gasto-comida-coor");
    const gastoDesayunos = document.getElementById("gasto-desayunos");
    const gastoAlmuerzos = document.getElementById("gasto-almuerzos");
    const gastoCenasGanadas = document.getElementById("gasto-cenas-ganadas");
    const gastoCenasPrestadas = document.getElementById("gasto-cenas-prestadas");
    const gastoHotel = document.getElementById("gasto-hotel");
    const gastoTransUrbano = document.getElementById("gasto-trans-urbano");
    const gastoTransVereda = document.getElementById("gasto-trans-vereda");
    const gastoVarios = document.getElementById("gasto-varios");

    const comidaCoor    = parseFloat(gastoComidaCoor ? gastoComidaCoor.value : 0) || 0;
    const desayunos     = parseFloat(gastoDesayunos ? gastoDesayunos.value : 0) || 0;
    const almuerzos     = parseFloat(gastoAlmuerzos ? gastoAlmuerzos.value : 0) || 0;
    const cenasGanadas  = parseFloat(gastoCenasGanadas ? gastoCenasGanadas.value : 0) || 0;
    const cenasPrestadas= parseFloat(gastoCenasPrestadas ? gastoCenasPrestadas.value : 0) || 0;
    const hotel         = parseFloat(gastoHotel ? gastoHotel.value : 0) || 0;
    const transUrbano   = parseFloat(gastoTransUrbano ? gastoTransUrbano.value : 0) || 0;
    const transVereda   = parseFloat(gastoTransVereda ? gastoTransVereda.value : 0) || 0;
    const varios        = parseFloat(gastoVarios ? gastoVarios.value : 0) || 0;
    const gastosExtra   = Array.from(document.querySelectorAll(".expense-amount"))
      .reduce((total, input) => total + (parseFloat(input.value) || 0), 0);

    const subtotalGastos = comidaCoor + desayunos + almuerzos + cenasGanadas + cenasPrestadas + hotel + transUrbano + transVereda + varios + gastosExtra;

    const totalEgresos = subtotalGastos;
    const totalEgresosInput = document.getElementById("total-egresos");
    if (totalEgresosInput) totalEgresosInput.value = totalEgresos.toFixed(2);

    // Deducción
    const consignaciones = parseFloat(document.getElementById("gasto-consignaciones")?.value || 0) || 0;
    const abonosGanados  = parseFloat(document.getElementById("gasto-abonos-ganados")?.value || 0) || 0;
    const totalDeduccion = consignaciones + abonosGanados;
    const totalDeduccionInput = document.getElementById("total-deduccion");
    if (totalDeduccionInput) totalDeduccionInput.value = totalDeduccion.toFixed(2);

    // Ingresos
    const saldoInicial = parseFloat(document.getElementById("coor-saldo-inicial")?.value || 0) || 0;
    const recaudoBase  = parseFloat(document.getElementById("ingreso-recaudo-base")?.value || 0) || 0;
    const abonosAdic   = parseFloat(document.getElementById("ingreso-abonos-adic")?.value || 0) || 0;
    const giros        = parseFloat(document.getElementById("ingreso-giros")?.value || 0) || 0;

    const totalIngresos = recaudoBase + abonosAdic + giros;
    const totalIngresosInput = document.getElementById("total-ingresos");
    if (totalIngresosInput) totalIngresosInput.value = totalIngresos.toFixed(2);

    // Balance Final: Saldo Anterior + Ingresos - Deducción - Egresos
    const saldoFinal = saldoInicial + totalIngresos - totalDeduccion - totalEgresos;

    const hayValores = saldoInicial !== 0 || totalIngresos !== 0 || totalDeduccion !== 0 || totalEgresos !== 0;

    const saldoInitEl = document.getElementById("card-coor-saldo-init");
    const ingresosEl = document.getElementById("card-coor-ingresos");
    const gastosEl = document.getElementById("card-coor-gastos");
    const saldoFinalEl = document.getElementById("card-coor-saldo-final");
    const saldoFinalBigEl = document.getElementById("coor-saldo-final-big");
    const balanceDetalleEl = document.getElementById("balance-detalle");

    if (!hayValores) {
      if (saldoInitEl) saldoInitEl.innerText = '';
      if (ingresosEl) ingresosEl.innerText = '';
      if (gastosEl) gastosEl.innerText = '';
      if (saldoFinalEl) saldoFinalEl.innerText = '';
      if (saldoFinalBigEl) saldoFinalBigEl.innerText = '';
      if (balanceDetalleEl) balanceDetalleEl.innerText = '';
      if (totalEgresosInput) totalEgresosInput.value = '';
      if (totalDeduccionInput) totalDeduccionInput.value = '';
      if (totalIngresosInput) totalIngresosInput.value = '';
      return;
    }

    if (saldoInitEl) saldoInitEl.innerText = "$" + saldoInicial.toFixed(2);
    if (ingresosEl) ingresosEl.innerText = "$" + totalIngresos.toFixed(2);
    if (gastosEl) gastosEl.innerText = "$" + totalEgresos.toFixed(2);
    if (saldoFinalEl) saldoFinalEl.innerText = "$" + saldoFinal.toFixed(2);
    if (saldoFinalBigEl) saldoFinalBigEl.innerText = "$" + saldoFinal.toFixed(2);
    if (balanceDetalleEl) balanceDetalleEl.innerText = `(${saldoInicial.toFixed(2)} + ${totalIngresos.toFixed(2)}) − ${totalDeduccion.toFixed(2)} − ${totalEgresos.toFixed(2)}`;
  }
</script>

</body>
</html>
