<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Sistema Contable de Campo - Óptica Angelus Visión</title>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    :root {
      /* Paleta del sistema Angelus Visión */
      --navy:        #1E293B;
      --navy-mid:    #0F172A;
      --navy-light:  #A0C4FF;
      --gold:        #DDB400;
      --gold-light:  #FFE880;
      --gold-subtle: #E2E8F0;

      --deduccion-fondo: #F4EEF8;
      --deduccion-texto: #1E293B;
      --deduccion-monto: #9E2A2B;

      --tabla-encabezado-fondo: #ecf0f5;
      --tabla-encabezado-texto: #1E293B;
      --tabla-encabezado-borde: #94ccb8;

      /* Colores editables de los botones superiores */
      --boton-restablecer-fondo: #E8F5F1;
      --boton-restablecer-texto: #087F5B;
      --boton-restablecer-borde: #A7DCCB;

      --boton-guardar-fondo: #008F73;
      --boton-guardar-texto: #FFFFFF;

      --boton-validar-fondo: #124E8C;
      --boton-validar-texto: #FFFFFF;

      --boton-cerrar-fondo: #0B3A5B;
      --boton-cerrar-texto: #FFFFFF;

      --boton-reporte-fondo: #16A085;
      --boton-reporte-texto: #FFFFFF;
      --boton-reporte-borde: #12856F;

      --boton-agregar-asesor-fondo: #008F73;
      --boton-agregar-asesor-texto: #ffffff;
      --boton-agregar-gasto-fondo: #008F73;
      --boton-agregar-gasto-texto: #ffffff;

      --green:       #A8E6CF;
      --green-light: #E8F8F2;
      --green-text:  #2D6A4F;

      --red:         #FFB7B2;
      --red-dark:    #9E2A2B;
      --red-light:   #FFECEB;
      --red-text:    #9E2A2B;

      --white:       #FFFFFF;
      --bg:          #F4F7F6;
      --surface:     #FFFFFF;
      --border:      #E2E8F0;
      --border-dark: #CBD5E1;
      --text:        #0F172A;
      --text-soft:   #334155;
      --text-muted:  #64748B;

      /* Linked fields (vinculados entre hojas) */
      --linked-bg:   #EBF2FF;
      --linked-text: #1E3A5F;
      --linked-bdr:  #bdd6ff;

      /* Sobre fondo oscuro */
      --on-dark-strong: rgba(255, 255, 255, 0.90);
      --on-dark-mid:    rgba(255, 255, 255, 0.70);
      --on-dark-soft:   rgba(255, 255, 255, 0.45);
      --on-dark-bg:     rgba(255, 255, 255, 0.10);
      --on-dark-border: rgba(255, 255, 255, 0.12);

      --shadow-sm:   0 1px 3px rgba(12, 45, 72, 0.10);
      --shadow-md:   0 4px 14px rgba(12, 45, 72, 0.14);
      --shadow-lg:   0 8px 28px rgba(12, 45, 72, 0.20);
      --radius-sm:   6px;
      --radius-md:   10px;
      --radius-lg:   14px;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Plus Jakarta Sans', sans-serif; }

    body {
      background: var(--bg);
      color: var(--text);
      padding: 0;
      min-height: 100vh;
    }

    .app-container {
      max-width: none;
      margin: 0 auto;
      display: flex;
      flex-direction: column;
      gap: 1rem;
      padding-bottom: 1.5rem;
    }

    /* ─── HEADER ─────────────────────────────────── */
    .header-card {
      background: var(--surface);
      border-radius: var(--radius-lg);
      box-shadow: var(--shadow-lg);
      padding: 0.8rem 1.25rem;
      display: grid;
      grid-template-columns: 1fr;
      align-items: center;
      gap: 1rem;
    }

    .header-top {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 0.75rem;
    }

    .header-main {
      min-width: 0;
      display: flex;
      flex-direction: column;
      gap: 0.6rem;
    }

    .brand-icon {
      width: 36px;
      height: 36px;
      background: var(--gold);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.1rem;
    }

    .brand-title h1 {
      font-size: 1.5rem;
      font-weight: 700;
      color: var(--navy);
      line-height: 1.2;
    }

    .brand-title p {
      font-size: 0.72rem;
      color: var(--text-muted);
    }

    .header-actions {
      display: flex;
      gap: 0.5rem;
      align-items: center;
      justify-content: flex-end;
      flex-wrap: wrap;
    }

    .nav-tabs {
      display: flex;
      gap: 0.35rem;
      background: var(--bg);
      padding: 0.28rem;
      border-radius: 10px;
      border: 1px solid var(--border);
      box-shadow: none;
    }

    .tab-btn {
      padding: 0.48rem 1rem;
      border: 1px solid transparent;
      border-radius: 8px;
      font-size: 0.8rem;
      font-weight: 700;
      letter-spacing: 0.01em;
      cursor: pointer;
      background: transparent;
      color: var(--text-muted);
      transition: all 0.2s ease;
      white-space: nowrap;
      box-shadow: inset 0 1px 0 rgba(255,255,255,0.04);
    }

    .tab-btn.active {
      background: var(--surface);
      color: var(--navy);
      border-color: var(--border);
      box-shadow: var(--shadow-sm);
    }

    .tab-btn:hover {
      color: var(--navy);
      background: var(--surface);
      transform: translateY(-1px);
    }

    .tab-btn.active:hover {
      background: var(--surface);
      transform: translateY(-1px);
    }

    .btn-print {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      padding: 0.45rem 0.9rem;
      border: 1px solid var(--boton-reporte-borde);
      border-radius: var(--radius-sm);
      font-size: 0.8rem;
      font-weight: 600;
      cursor: pointer;
      background: var(--boton-reporte-fondo);
      color: var(--boton-reporte-texto);
      transition: all 0.18s ease;
    }

    .btn-print:hover { background: color-mix(in srgb, var(--boton-reporte-fondo) 88%, #000000 12%); color: var(--boton-reporte-texto); filter: none; }

    .btn-reset {
      background: var(--boton-restablecer-fondo);
      color: var(--boton-restablecer-texto);
      border: 1px solid var(--boton-restablecer-borde);
      margin-left: 1.1rem;
      box-shadow: var(--shadow-sm);
    }

    .btn-reset:hover { background: color-mix(in srgb, var(--boton-restablecer-fondo) 88%, #000000 12%); color: var(--boton-restablecer-texto); filter: none; }

    .header-actions .btn-guardar { background: var(--boton-guardar-fondo); color: var(--boton-guardar-texto); }
    .header-actions .btn-validar { background: var(--boton-validar-fondo); color: var(--boton-validar-texto); }
    .header-actions .btn-cerrar { background: var(--boton-cerrar-fondo); color: var(--boton-cerrar-texto); }
    .header-actions .btn-guardar:hover { background: color-mix(in srgb, var(--boton-guardar-fondo) 88%, #000000 12%); color: var(--boton-guardar-texto); filter: none; }
    .header-actions .btn-validar:hover { background: color-mix(in srgb, var(--boton-validar-fondo) 88%, #000000 12%); color: var(--boton-validar-texto); filter: none; }
    .header-actions .btn-cerrar:hover { background: color-mix(in srgb, var(--boton-cerrar-fondo) 88%, #000000 12%); color: var(--boton-cerrar-texto); filter: none; }
    .header-actions .btn-print:hover { background: color-mix(in srgb, var(--boton-reporte-fondo) 88%, #000000 12%); color: var(--boton-reporte-texto); filter: none; }

    /* Hover único: solo se oscurece el fondo de cada botón. */
    .tab-btn:hover,
    .tab-btn.active:hover { background: color-mix(in srgb, var(--surface) 88%, #000000 12%); color: var(--navy); }
    .btn-primary:hover { background: color-mix(in srgb, var(--green) 88%, #000000 12%); color: var(--green-text); filter: none; }
    .btn-danger:hover { background: color-mix(in srgb, var(--red) 88%, #000000 12%); color: var(--white); filter: none; }
    .btn-agregar-asesor:hover { background: color-mix(in srgb, var(--boton-agregar-asesor-fondo) 88%, #000000 12%); color: var(--boton-agregar-asesor-texto); filter: none; }
    .add-expense-button:hover { background: color-mix(in srgb, var(--boton-agregar-gasto-fondo) 88%, #000000 12%); color: var(--boton-agregar-gasto-texto); filter: none; }

    .btn-agregar-asesor {
      background: var(--boton-agregar-asesor-fondo);
      color: var(--boton-agregar-asesor-texto);
    }


    .modal-backdrop {
      position: fixed;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 1rem;
      background: rgba(12, 45, 72, 0.52);
      backdrop-filter: blur(3px);
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      transition: opacity 0.2s ease, visibility 0.2s ease;
      z-index: 1000;
    }

    .modal-backdrop.visible {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
    }

    .app-modal {
      width: min(440px, 100%);
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 18px;
      box-shadow: var(--shadow-lg);
      overflow: hidden;
      transform: translateY(8px);
      transition: transform 0.2s ease;
    }

    .modal-backdrop.visible .app-modal {
      transform: translateY(0);
    }

    .app-modal-header {
      background: linear-gradient(135deg, var(--navy), var(--navy-mid));
      color: var(--white);
      padding: 1rem 1.1rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 1rem;
    }

    .app-modal-header h3 {
      font-size: 1rem;
      font-weight: 700;
    }

    .app-modal-close {
      border: none;
      background: rgba(255,255,255,0.12);
      color: var(--white);
      width: 32px;
      height: 32px;
      border-radius: 50%;
      cursor: pointer;
      font-size: 1.1rem;
    }

    .app-modal-body {
      padding: 1.1rem;
      color: var(--text-soft);
      display: flex;
      flex-direction: column;
      gap: 0.9rem;
    }

    .app-modal-body p {
      font-size: 0.88rem;
      line-height: 1.5;
    }

    .app-modal-actions {
      display: flex;
      justify-content: flex-end;
      gap: 0.6rem;
      margin-top: 0.25rem;
    }

    .app-modal-btn {
      border: none;
      border-radius: 10px;
      padding: 0.75rem 1rem;
      font-weight: 700;
      font-size: 0.82rem;
      cursor: pointer;
      transition: transform 0.15s ease, opacity 0.15s ease;
    }

    .app-modal-btn:hover { transform: translateY(-1px); }

    .app-modal-btn.secondary {
      background: var(--bg);
      color: var(--text-soft);
      border: 1px solid var(--border);
    }

    .app-modal-btn.primary {
      background: linear-gradient(135deg, var(--red), var(--red-dark));
      color: var(--white);
    }

    /* Meta Fields Row */
    .meta-row {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
      gap: 0.625rem;
    }

    @media (max-width: 760px) {
      .header-card {
        grid-template-columns: 1fr;
        gap: 0.75rem;
        padding: 0.75rem;
        width: 100%;
      }

      .brand-title {
        text-align: center;
      }

      .brand-title h1,
      .brand-title p {
        text-align: center;
      }

      .header-main,
      .header-top,
      .header-actions,
      .nav-tabs {
        width: 100%;
        min-width: 0;
      }

      .header-top {
        display: flex;
        flex-direction: column;
        align-items: stretch;
        gap: 0.6rem;
      }

      .header-actions {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0.5rem;
        align-items: stretch;
      }

      .header-actions .nav-tabs {
        grid-column: 1 / -1;
      }

      .btn-reset {
        margin-left: 0;
      }

      .nav-tabs {
        display: grid;
        grid-template-columns: 1fr 1fr;
      }

      .tab-btn {
        min-width: 0;
        white-space: normal;
        line-height: 1.15;
        padding: 0.5rem 0.35rem;
      }

      .btn-print {
        display: flex;
        width: 100%;
        justify-content: center;
        align-items: center;
        text-align: center;
      }
    }

    .meta-field {
      display: flex;
      flex-direction: column;
      gap: 0.2rem;
    }

    .meta-field label {
      font-size: 0.65rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      color: var(--white);
      display: flex;
      align-items: center;
      gap: 0.3rem;
    }

    .meta-field input {
      padding: 0.45rem 0.625rem;
      border: 1px solid var(--on-dark-border);
      border-radius: var(--radius-sm);
      font-size: 0.825rem;
      background: rgba(255,255,255,0.08);
      color: var(--white);
      outline: none;
      transition: border-color 0.15s;
    }

    .meta-field input:focus { border-color: var(--gold); }

    /* ─── TAB CONTENT ────────────────────────────── */
    .tab-content { display: none; flex-direction: column; gap: 1rem; }
    .tab-content.active { display: flex; }

    /* ─── STAT CARDS ─────────────────────────────── */
    .summary-cards {
      display: grid;
      grid-template-columns: 1fr 1fr 1fr 1.75fr;
      gap: 0.7rem;
      align-items: stretch;
      margin-bottom: 0.2rem;
    }

    .stat-card {
      background: linear-gradient(180deg, rgba(255,255,255,0.96), rgba(247,250,252,0.96));
      padding: 0.8rem 0.9rem;
      border-radius: var(--radius-md);
      border: 1px solid rgba(148,163,184,0.22);
      box-shadow: 0 10px 24px rgba(15, 23, 42, 0.08), inset 0 1px 0 rgba(255,255,255,0.7);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.65rem;
      min-height: 78px;
      transition: transform 0.18s ease, box-shadow 0.18s ease;
    }

    .stat-card:hover {
      transform: translateY(-1px);
      box-shadow: 0 12px 28px rgba(15, 23, 42, 0.12), inset 0 1px 0 rgba(255,255,255,0.7);
    }

    .stat-card .sc-header {
      display: flex;
      align-items: center;
      gap: 0.45rem;
      flex: 1;
      min-width: 0;
    }

    .stat-card .sc-icon {
      width: 28px;
      height: 28px;
      border-radius: var(--radius-sm);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.85rem;
      background: var(--gold-subtle);
      color: var(--gold);
      flex-shrink: 0;
    }

    .stat-card .label {
      font-size: 0.85rem;
      font-weight: 700;
      color: rgb(100, 116, 139);
      text-transform: uppercase;
      letter-spacing: 0.03em;
      line-height: 1.2;
      overflow-wrap: anywhere;
    }

    .stat-card .value {
      font-size: 1.45rem;
      font-weight: 800;
      color: var(--navy);
      line-height: 1.1;
      padding-left: 0.65rem;
      border-left: 1px solid rgba(148, 163, 184, 0.45);
      white-space: nowrap;
      flex-shrink: 0;
      text-align: right;
    }

    .stat-card.sc-blue  {
      background: linear-gradient(180deg, #0d2741 0%, #123a5b 100%);
      border: 1px solid rgba(255,255,255,0.06);
      box-shadow: 0 12px 24px rgba(13, 39, 65, 0.26);
    }
    .stat-card.sc-blue .label  { color: rgba(255,255,255,0.75); }
    .stat-card.sc-blue .value  { color: var(--white); border-left-color: rgba(255,255,255,0.28); }
    .stat-card.sc-blue .sc-icon{ background: rgba(255,255,255,0.08); color: var(--white); }

    .stat-card.sc-green {
      background: linear-gradient(180deg, #1ea95f 0%, #178a4d 100%);
      border: 1px solid rgba(255,255,255,0.08);
      box-shadow: 0 12px 24px rgba(22, 163, 74, 0.28);
    }
    .stat-card.sc-green .label { color: rgba(255,255,255,0.78); }
    .stat-card.sc-green .value { color: var(--white); border-left-color: rgba(255,255,255,0.28); }
    .stat-card.sc-green .sc-icon{ background: rgba(255,255,255,0.12); color: var(--white); }

    .stat-card.sc-navy  {
      background: linear-gradient(180deg, #122b48 0%, #0b1f36 100%);
      border: 1px solid rgba(255,255,255,0.08);
      box-shadow: 0 14px 28px rgba(11, 31, 54, 0.28);
    }
    .stat-card.sc-navy .label  { color: rgba(255,255,255,0.8); }
    .stat-card.sc-navy .value  { color: var(--gold-light); border-left-color: rgba(255,255,255,0.28); }
    .stat-card.sc-navy .sc-icon{ background: rgba(255,255,255,0.08); color: var(--gold-light); }

    .summary-final-card {
      padding: 0.8rem 1rem;
      min-height: 96px;
      grid-column: auto;
      min-width: 0;
      flex: none;
      width: 100%;
    }

    .summary-final-card .sc-summary-content {
      display: flex;
      flex-direction: column;
      gap: 0.2rem;
      flex: 1;
      min-width: 0;
    }

    .summary-final-card .sc-formula {
      font-size: 0.7rem;
      color: var(--on-dark-soft);
      line-height: 1.3;
      white-space: normal;
    }

    .summary-final-card .sc-detail {
      font-size: 0.72rem;
      color: var(--gold-light);
      font-weight: 600;
      line-height: 1.3;
    }

    .summary-final-card .value {
      font-size: 1.9rem;
      min-width: 120px;
    }

    /* ─── TABLE CARD (wrapper) ───────────────────── */
    .table-card {
      background: var(--surface);
      border-radius: var(--radius-md);
      border: 1px solid var(--border);
      box-shadow: var(--shadow-md);
      overflow: hidden;
    }

    .table-wrapper { overflow-x: auto; }

    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.82rem;
      min-width: 980px;
    }

    thead th {
      background: var(--tabla-encabezado-fondo);
      color: var(--tabla-encabezado-texto);
      font-weight: 700;
      font-size: 0.67rem;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      padding: 0.75rem 0.5rem;
      border-bottom: 2px solid var(--tabla-encabezado-borde);
      text-align: center;
      white-space: nowrap;
    }

    tbody tr { transition: background 0.12s; }
    tbody tr:hover { background: var(--gold-subtle); }

    tbody td {
      padding: 0.5rem 0.4rem;
      border-bottom: 1px solid var(--border);
      text-align: center;
      vertical-align: middle;
    }

    td input, td select {
      width: 100%;
      padding: 0.38rem 0.3rem;
      border: 1px solid var(--border);
      border-radius: var(--radius-sm);
      font-size: 0.82rem;
      text-align: center;
      background: var(--surface);
      outline: none;
      color: var(--text);
      transition: border-color 0.15s, box-shadow 0.15s;
    }

    td input:focus, td select:focus {
      border-color: var(--gold);
      box-shadow: 0 0 0 2px rgba(212, 161, 56, 0.15);
    }

    td input[readonly] {
      background: var(--bg);
      color: var(--text-soft);
      font-weight: 600;
      border-color: transparent;
      cursor: default;
    }

    .net-recaudo-cell {
      background: var(--green-light) !important;
      color: var(--green-text) !important;
      font-weight: 700 !important;
      border-color: var(--border-dark) !important;
    }

    tfoot tr { background: var(--navy); color: var(--white); }

    tfoot td {
      padding: 0.8rem 0.5rem !important;
      font-size: 0.875rem;
      font-weight: 700;
      vertical-align: middle;
      color: var(--white);
      border: none !important;
    }

    /* ─── TABLE BOTTOM BAR ───────────────────────── */
    .table-footer-bar {
      padding: 0.75rem 1rem;
      background: var(--bg);
      border-top: 1px solid var(--border);
    }

    /* ─── SECTION CARD (form panel) ─────────────── */
    .section-card {
      background: linear-gradient(180deg, rgba(255,255,255,0.98), rgba(248,250,252,0.98));
      border-radius: var(--radius-md);
      border: 1px solid rgba(148,163,184,0.18);
      box-shadow: 0 12px 26px rgba(15, 23, 42, 0.08);
      overflow: hidden;
    }

    .section-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 0.75rem 1rem;
      background: linear-gradient(180deg, rgba(240,248,245,0.96), rgba(232,244,237,0.96));
      border-bottom: 2px solid var(--green);
    }

    .section-header-left {
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .section-badge {
      width: 22px;
      height: 22px;
      background: var(--green);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.7rem;
      font-weight: 800;
      color: var(--white);
      flex-shrink: 0;
    }

    .section-badge-warning {
      background: var(--gold);
    }

    .section-badge-danger {
      background: var(--red);
    }

    .section-title-text {
      font-size: 0.875rem;
      font-weight: 700;
      color: var(--navy);
    }

    .section-subtitle {
      font-size: 0.72rem;
      color: rgb(100, 116, 139);
    }

    /* ─── FORM ROWS ──────────────────────────────── */
    .form-row {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.45rem 0.875rem;
      border-bottom: 1px solid var(--border);
      min-height: 42px;
    }

    .form-row:last-child { border-bottom: none; }

    .form-row-label {
      font-size: 0.78rem;
      font-weight: 600;
      color: var(--text-soft);
      display: flex;
      align-items: center;
      gap: 0.3rem;
      white-space: nowrap;
      flex-shrink: 0;
      min-width: 160px;
    }

    .form-row-label .row-icon {
      font-size: 0.8rem;
      color: var(--green-text);
    }

    .form-row-inputs {
      display: flex;
      gap: 0.4rem;
      align-items: center;
      flex: 1;
    }

    .form-row-inputs input,
    .form-row-inputs select {
      padding: 0.35rem 0.45rem;
      border: 1px solid var(--border);
      border-radius: var(--radius-sm);
      font-size: 0.8rem;
      background: var(--surface);
      color: var(--text);
      outline: none;
      transition: border-color 0.15s, box-shadow 0.15s;
      flex: 1;
      min-width: 0;
    }

    .form-row-inputs input:focus,
    .form-row-inputs select:focus {
      border-color: var(--green);
      box-shadow: 0 0 0 2px rgb(22 163 74 / 0.12);
    }

    .form-row-inputs input[readonly] {
      background: var(--bg);
      color: var(--text-soft);
      font-weight: 600;
      border-color: transparent;
    }

    .extra-expenses {
      padding: 0.55rem 0.875rem 0.7rem;
      background: var(--bg);
      border-bottom: 1px solid var(--border);
    }

    .extra-expense-row {
      display: flex;
      align-items: center;
      gap: 0.4rem;
      margin-bottom: 0.35rem;
    }

    .extra-expense-row:last-child { margin-bottom: 0; }

    .extra-expense-row input {
      padding: 0.35rem 0.45rem;
      border: 1px solid var(--border);
      border-radius: var(--radius-sm);
      font-size: 0.8rem;
      background: var(--surface);
      color: var(--text);
      outline: none;
      min-width: 0;
    }

    .extra-expense-row input:focus {
      border-color: var(--green);
      box-shadow: 0 0 0 2px rgb(22 163 74 / 0.12);
    }

    .extra-expense-row .expense-amount { width: 120px; }
    .extra-expense-row .expense-description { flex: 1; }

    .extra-expense-icon {
      color: var(--green-text);
      font-size: 0.85rem;
      flex-shrink: 0;
    }

    .extra-expense-label {
      min-width: 70px;
      color: var(--text-soft);
      font-size: 0.78rem;
      font-weight: 700;
      white-space: nowrap;
    }

    .add-expense-button {
      margin-top: 0.5rem;
      padding: 0.35rem 0.7rem;
      border: 1px solid var(--green);
      border-radius: var(--radius-sm);
      background: var(--surface);
      color: var(--green-text);
      font-size: 0.75rem;
      font-weight: 700;
      cursor: pointer;
    }

    .add-expense-button:hover { background: var(--green-light); }

    /* sub-label inline (para grupos con etiqueta encima del input) */
    .input-group {
      display: flex;
      flex-direction: column;
      gap: 0.1rem;
      flex: 1;
      min-width: 0;
    }

    .input-group .sub-label {
      font-size: 0.58rem;
      font-weight: 700;
      color: rgb(100, 116, 139);
      text-transform: uppercase;
      letter-spacing: 0.03em;
    }

    .input-group input,
    .input-group select {
      padding: 0.32rem 0.4rem;
      border: 1px solid var(--border);
      border-radius: var(--radius-sm);
      font-size: 0.79rem;
      background: var(--surface);
      color: var(--text);
      outline: none;
      width: 100%;
      transition: border-color 0.15s;
    }

    .input-group input:focus,
    .input-group select:focus {
      border-color: var(--green);
      box-shadow: 0 0 0 2px rgb(22 163 74 / 0.12);
    }

    .input-group input[readonly] {
      background: var(--bg);
      color: var(--text-soft);
      font-weight: 600;
      border-color: transparent;
    }

    .linked-field {
      background: var(--linked-bg) !important;
      color: var(--linked-text) !important;
      font-weight: 700 !important;
      border-color: var(--linked-bdr) !important;
    }

    .sub-label {
      font-size: 0.6rem;
      font-weight: 700;
      color: rgb(100, 116, 139);
      text-transform: uppercase;
      letter-spacing: 0.03em;
      display: block;
    }

    /* ─── DUAL CURRENCY ROW ──────────────────────── */
    .form-row-blue { background: rgba(212, 161, 56, 0.07); }

    /* ─── TOTAL ROWS ─────────────────────────────── */
    .total-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 0.8rem 1rem;
      background: linear-gradient(180deg, #0f233d 0%, #122b48 100%);
      border-top: 1px solid rgba(255,255,255,0.08);
    }

    .total-row-label {
      font-size: 0.88rem;
      font-weight: 700;
      color: var(--white);
      display: flex;
      align-items: center;
      gap: 0.4rem;
      letter-spacing: 0.02em;
    }

    .total-row-value {
      font-size: 1.15rem;
      font-weight: 800;
      color: var(--gold-light);
      min-width: 100px;
      text-align: right;
    }

    .total-row input[readonly] {
      background: transparent;
      color: var(--gold-light);
      font-weight: 800;
      font-size: 1.15rem;
      border: none;
      text-align: left;
      width: 82px;
      padding: 0;
      outline: none;
    }

    .total-amount {
      display: inline-flex;
      align-items: center;
      justify-content: flex-end;
      gap: 0;
      min-width: 0;
    }

    .total-amount .currency-prefix {
      color: var(--gold-light);
      font-size: 1.15rem;
      font-weight: 800;
    }

    .total-row-purple { background: var(--navy-mid); border-top: 2px solid rgba(255,255,255,0.08); }
    .total-row-purple input[readonly] { color: var(--gold-light); }
    .total-row-purple .total-row-label { color: var(--white); }

    /* ─── BALANCE BOX ────────────────────────────── */
    .balance-box {
      background: var(--navy);
      border-radius: var(--radius-md);
      border: 1px solid rgba(255,255,255,0.08);
      padding: 1rem 1.25rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      box-shadow: var(--shadow-lg);
      gap: 1.5rem;
    }

    .balance-box-left {
      display: flex;
      flex-direction: column;
      gap: 0.15rem;
      flex: 1;
      min-width: 0;
    }

    .balance-box-label {
      font-size: 1rem;
      font-weight: 700;
      color: var(--white);
      white-space: nowrap;
    }

    .balance-box-formula {
      font-size: 0.78rem;
      color: var(--on-dark-soft);
      margin-top: 0.15rem;
    }

    .balance-box-detalle {
      font-size: 0.78rem;
      color: var(--gold-light);
      margin-top: 0.1rem;
      font-weight: 600;
    }

    .balance-total {
      font-size: 1.8rem;
      font-weight: 800;
      color: var(--gold-light);
      white-space: nowrap;
      flex-shrink: 0;
    }

    /* ─── LAYOUT GRID CONTABILIDAD ───────────────── */
    .coordinacion-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1rem;
    }

    @media (max-width: 1100px) {
      .coordinacion-grid { grid-template-columns: 1fr; }
    }

    @media (max-width: 560px) {
      .summary-cards {
        grid-template-columns: 1fr 1fr !important;
        gap: 0.5rem;
      }

      .summary-final-card {
        grid-column: span 2;
        min-height: 108px;
      }

      .summary-final-card .sc-formula,
      .summary-final-card .sc-detail {
        white-space: normal;
      }

      .stat-card {
        min-height: 76px;
        padding: 0.55rem 0.65rem;
      }

      .stat-card .sc-header {
        gap: 0.35rem;
      }

      .stat-card .value {
        font-size: 1rem;
        padding-left: 0.45rem;
      }
    }

    .left-col { display: flex; flex-direction: column; gap: 1rem; }

    /* ─── BUTTONS ────────────────────────────────── */
    .btn {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      padding: 0.5rem 1rem;
      border-radius: var(--radius-sm);
      font-size: 0.82rem;
      font-weight: 600;
      cursor: pointer;
      border: none;
      transition: all 0.18s ease;
    }

    .btn-primary {
      background: var(--green);
      color: var(--white);
      box-shadow: 0 4px 12px rgba(22, 163, 74, 0.28);
    }

    .btn-primary:hover { background: rgb(21, 128, 61); }

    .btn-danger {
      background: var(--red);
      color: var(--white);
      padding: 0.25rem 0.45rem;
      border-radius: 4px;
      font-size: 0.75rem;
    }

    .btn-danger:hover { background: var(--red); filter: brightness(0.88); }

    .meta-field label { color: var(--text-muted); }
    .meta-field input { background: #F9FBFC; color: var(--text); border-color: var(--border); }
    .meta-field input:focus { border-color: #83C5BE; }

    .stat-card { background: var(--surface); border-color: var(--border); box-shadow: var(--shadow-md); }
    .stat-card .sc-icon { background: var(--gold-subtle); color: var(--gold-light); }
    .stat-card .label { color: var(--text-muted); }
    .stat-card .value { color: var(--navy); }
    .stat-card.sc-green { background: linear-gradient(180deg, #A8E6CF, #83C5BE); border-color: rgba(45,106,79,0.14); box-shadow: var(--shadow-md); }
    .stat-card.sc-green .label, .stat-card.sc-green .value { color: #2D6A4F; }

    .section-card { background: var(--surface); border-color: var(--border); box-shadow: var(--shadow-md); }
    .section-header { background: #F9FBFC; border-bottom-color: #83C5BE; }
    .section-title-text { color: var(--navy); }
    .section-badge { background: var(--green); color: var(--green-text); }
    .section-badge-warning { background: #FFDAC1; color: #9A5B19; }
    .section-badge-danger { background: var(--red); color: var(--red-dark); }

    .form-row-blue { background: #EBF2FF; }
    .form-row-inputs input, .form-row-inputs select,
    .input-group input, .input-group select,
    .extra-expense-row input { background: var(--surface); border-color: var(--border); color: var(--text); }
    .form-row-inputs input:focus, .form-row-inputs select:focus,
    .input-group input:focus, .input-group select:focus,
    .extra-expense-row input:focus { border-color: #83C5BE; box-shadow: 0 0 0 2px rgba(131,197,190,0.2); }
    .extra-expenses { background: #F9FBFC; }
    .add-expense-button {
      border-color: var(--boton-agregar-gasto-texto);
      background: var(--boton-agregar-gasto-fondo);
      color: var(--boton-agregar-gasto-texto);
    }

    .total-row { background: var(--navy); }
    .total-row-purple { background: var(--deduccion-fondo); }
    .total-row-purple .total-row-label { color: var(--deduccion-texto); }
    .total-row-purple input[readonly], .total-row-purple .currency-prefix { color: var(--deduccion-monto); }
    .balance-box { background: linear-gradient(135deg, var(--navy), var(--navy-mid)); }
    .balance-total { color: var(--gold-light); }

    .btn-primary { background: var(--green); color: var(--green-text); box-shadow: var(--shadow-sm); }
    .btn-reset { background: var(--boton-restablecer-fondo); color: var(--boton-restablecer-texto); border-color: var(--boton-restablecer-borde); }

    .header-actions .btn-guardar:hover { background: color-mix(in srgb, var(--boton-guardar-fondo) 88%, #000000 12%); color: var(--boton-guardar-texto); filter: none; }
    .header-actions .btn-validar:hover { background: color-mix(in srgb, var(--boton-validar-fondo) 88%, #000000 12%); color: var(--boton-validar-texto); filter: none; }
    .header-actions .btn-cerrar:hover { background: color-mix(in srgb, var(--boton-cerrar-fondo) 88%, #000000 12%); color: var(--boton-cerrar-texto); filter: none; }
    .header-actions .btn-print:hover { background: color-mix(in srgb, var(--boton-reporte-fondo) 88%, #000000 12%); color: var(--boton-reporte-texto); filter: none; }
    .header-actions .btn-reset:hover { background: color-mix(in srgb, var(--boton-restablecer-fondo) 88%, #000000 12%); color: var(--boton-restablecer-texto); filter: none; }

    /* ─── PRINT ──────────────────────────────────── */
    .print-header { display: none; }

    @media print {
      @page {
        size: letter landscape;
        margin: 8mm 10mm 10mm 10mm;
      }

      * {
        -webkit-print-color-adjust: exact !important;
        print-color-adjust: exact !important;
      }

      html, body {
        width: 100%;
        background: #fff;
        font-size: 9pt;
      }

      body {
        padding: 0;
        margin: 0;
      }

      .btn, .btn-danger, .btn-print { display: none !important; }

      .nav-tabs {
        display: flex !important;
        visibility: visible !important;
        opacity: 1 !important;
      }

      .tab-btn {
        background: rgba(12, 45, 72, 0.10) !important;
        color: var(--white) !important;
        border: 1px solid rgba(12, 45, 72, 0.20) !important;
      }

      .tab-btn.active {
        background: var(--green) !important;
        color: var(--white) !important;
      }

      .print-header { display: block !important; }

      .app-container {
        max-width: 100% !important;
        width: 100% !important;
        gap: 0.4rem !important;
        margin: 0 auto;
      }

      .header-card {
        border-radius: 14px !important;
        overflow: hidden !important;
        margin-bottom: 0.3rem;
        padding: 0.6rem 1rem;
        grid-template-columns: 110px 1fr;
        gap: 0.6rem;
        display: flex !important;
        flex-direction: column !important;
      }

      .header-top {
        display: flex !important;
        justify-content: space-between !important;
        align-items: center !important;
        flex-wrap: nowrap !important;
      }

      .header-actions {
        display: flex !important;
        justify-content: flex-end !important;
      }

      .header-card img { width: 100px; }

      .brand-title h1 { font-size: 0.95rem; }
      .brand-title p { display: block !important; }
      .brand-title p { font-size: 0.62rem; }

      .meta-row { grid-template-columns: repeat(3, 1fr); gap: 0.5rem; }
      .meta-field label { font-size: 0.58rem; }
      .meta-field input { font-size: 0.72rem; padding: 0.3rem 0.45rem; }

      /* PÁGINA 1: Recepción Afiliaciones */
      #tab-afiliaciones {
        display: block !important;
        page-break-after: always;
        page-break-inside: avoid;
      }

      /* PÁGINA 2: Contabilidad Coordinador */
      #tab-contabilidad {
        display: block !important;
        page-break-after: avoid;
        page-break-inside: avoid;
      }

      .tab-content { display: block !important; gap: 0.5rem !important; }

      .table-card, .section-card, .stat-card, .balance-box {
        border: 1px solid #000 !important;
        box-shadow: none !important;
        border-radius: 10px !important;
        page-break-inside: avoid;
      }

      .summary-cards {
        grid-template-columns: 1fr 1fr 1fr 1.6fr !important;
        gap: 0.35rem !important;
      }

      .summary-final-card {
        grid-column: auto !important;
      }

      .stat-card {
        padding: 0.5rem 0.65rem !important;
        min-height: 58px !important;
        display: flex !important;
        align-items: center !important;
        justify-content: space-between !important;
      }

      .stat-card .sc-header {
        display: flex !important;
        align-items: center !important;
        min-width: 0 !important;
        flex: 1 1 auto !important;
      }

      .stat-card .value {
        font-size: 0.96rem !important;
        padding-left: 0.45rem !important;
        border-left: 1px solid rgba(148, 163, 184, 0.45) !important;
        margin-left: 0.25rem !important;
        white-space: nowrap !important;
      }

      .stat-card .label { font-size: 0.58rem !important; line-height: 1.15 !important; }
      .stat-card .sc-icon { width: 22px !important; height: 22px !important; font-size: 0.72rem !important; flex-shrink: 0 !important; }

      .table-wrapper { overflow: visible !important; }

      table {
        width: 100% !important;
        min-width: 0 !important;
        table-layout: fixed !important;
        font-size: 7.2pt !important;
      }

      thead th {
        white-space: normal !important;
        word-break: break-word;
        line-height: 1.15;
        padding: 4px 2px !important;
        font-size: 0.58rem;
      }

      tbody td { padding: 2px !important; }

      th, td { border: 1px solid #000 !important; padding: 2px !important; }

      /* La columna de borrar filas no aporta nada en el PDF impreso */
      .table-card th:last-child, .table-card td:last-child { display: none !important; }

      td input, td select { font-size: 7.2pt !important; padding: 1px !important; border: none !important; background: transparent !important; }

      input, select { border: none !important; background: transparent !important; }

      thead { display: table-header-group; }
      tbody tr { page-break-inside: avoid; }

      /* Contabilidad en dos columnas para landscape */
      .coordinacion-grid {
        grid-template-columns: 1fr 1fr !important;
        gap: 0.5rem !important;
      }

      .section-header { padding: 0.5rem 0.7rem; }
      .section-title-text { font-size: 0.78rem; }
      .section-badge { width: 18px; height: 18px; font-size: 0.58rem; }

      .form-row { padding: 0.35rem 0.6rem; min-height: 32px; }
      .form-row-label { font-size: 0.68rem; min-width: 120px; }
      .form-row-inputs input, .form-row-inputs select { font-size: 0.7rem; padding: 0.25rem 0.35rem; }

      .input-group .sub-label { font-size: 0.52rem; }
      .input-group input, .input-group select { font-size: 0.7rem; padding: 0.25rem 0.35rem; }

      .total-row { padding: 0.5rem 0.7rem; }
      .total-row-label { font-size: 0.72rem; }
      .total-row input[readonly] { font-size: 0.88rem; }
      .total-amount .currency-prefix { font-size: 0.88rem; }

      .balance-box { padding: 0.7rem 1rem; }
      .balance-box-label { font-size: 0.85rem; }
      .balance-box-formula { font-size: 0.62rem; }
      .balance-box-detalle { font-size: 0.62rem; }
      .balance-total { font-size: 1.4rem; }

      .extra-expenses { padding: 0.4rem 0.6rem; }
      .extra-expense-row { margin-bottom: 0.25rem; }
      .extra-expense-row input { font-size: 0.7rem; padding: 0.25rem 0.35rem; }
      .extra-expense-label { font-size: 0.68rem; min-width: 55px; }
    }
  </style>
</head>

<body>
<div class="app-container">

  <!-- ═══ HEADER ═══ -->
  <div class="header-card">
    <div class="header-main">
      <div class="header-top">
        <div class="brand-title">
          <h1 data-empresa-nombre>Óptica Angelus Visión</h1>
          <p>Sistema Operativo y Contable de Campo</p>
        </div>
        <div class="header-actions">
          <div class="nav-tabs">
            <button class="tab-btn active" onclick="switchTab('tab-afiliaciones', this)">1. Recepción Afiliaciones</button>
            <button class="tab-btn" onclick="switchTab('tab-contabilidad', this)">2. Contabilidad Coordinador</button>
          </div>
          <button class="btn btn-reset" type="button" onclick="mostrarModalReset()">↺ Reestablecer</button>
          <button class="btn btn-primary btn-guardar" type="button" onclick="guardarYSincronizarContabilidad()">💾 Guardar borrador</button>
          <button class="btn btn-primary btn-validar" type="button" onclick="validarCierreContabilidad()">✓ Validar cierre</button>
          <button class="btn btn-primary btn-cerrar" type="button" onclick="mostrarConfirmacionCierreContabilidad()">🔒 Cerrar contabilidad</button>
          <button class="btn-print" onclick="mostrarReporteCierreContabilidad()">🖨️ Generar reporte</button>
        </div>
      </div>
      <div class="meta-row">
        <div class="meta-field">
          <label>📅 Fecha Jornada</label>
          <input type="date" id="global-fecha" value="">
        </div>
        <div class="meta-field">
          <label>📍 Municipio</label>
          <input type="text" id="global-municipio" value="">
        </div>
        <div class="meta-field">
          <label>👤 Coordinador</label>
          <input type="text" id="global-coordinador" value="">
        </div>
        <div class="meta-field">
          <label>🗂️ Estado</label>
          <input type="text" id="estado-draft-contabilidad" value="Borrador local" readonly>
        </div>
      </div>
      <div class="meta-row" id="resumen-cierre-contabilidad" style="margin-top:0.6rem; background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.08); padding: 0.7rem 0.85rem; border-radius: 12px; display:flex; flex-wrap:wrap; gap:0.75rem; align-items:center; color:#fff;">
        <span style="font-size:0.72rem; font-weight:700; letter-spacing:0.08em; text-transform:uppercase; opacity:0.8;">Estado jornada:</span>
        <strong id="estado-jornada-resumen" style="font-size:0.82rem;">Borrador</strong>
        <span style="font-size:0.72rem; opacity:0.8;">|</span>
        <span style="font-size:0.72rem; opacity:0.8;">Total afiliaciones: <strong id="resumen-total-afiliaciones">0</strong></span>
        <span style="font-size:0.72rem; opacity:0.8;">|</span>
        <span style="font-size:0.72rem; opacity:0.8;">Saldo final: <strong id="resumen-saldo-final">$0</strong></span>
      </div>
    </div>
  </div>

  <!-- ═══ PESTAÑA 1: RECEPCIÓN DE AFILIACIONES ═══ -->
  <div id="tab-afiliaciones" class="tab-content active">

    <div class="summary-cards">
      <div class="stat-card">
        <div class="sc-header">
          <div class="sc-icon">👥</div>
          <div class="label">Total Afiliaciones</div>
        </div>
        <div class="value" id="card-tot-aff">0</div>
      </div>
      <div class="stat-card">
        <div class="sc-header">
          <div class="sc-icon">💵</div>
          <div class="label">Recaudo Abono</div>
        </div>
        <div class="value" id="card-tot-abono">$0</div>
      </div>
      <div class="stat-card">
        <div class="sc-header">
          <div class="sc-icon">🍽️</div>
          <div class="label">Almuerzos Campo</div>
        </div>
        <div class="value" id="card-tot-almuerzo">$0</div>
      </div>
      <div class="stat-card sc-navy">
        <div class="sc-header">
          <div class="sc-icon">✅</div>
          <div class="label">Recaudo Neto Asesores</div>
        </div>
        <div class="value" id="card-tot-neto">$0</div>
      </div>
    </div>

    <div class="table-card">
      <div class="table-wrapper">
        <table>
          <thead>
            <tr>
              <th style="width:30px;">N°</th>
              <th style="width:146px;">Asesor / Promotor</th>
              <th style="width:88px;">Rol</th>
              <th style="width:50px;">Nº Aff</th>
              <th style="width:74px;">Recaudo ($)</th>
              <th style="width:60px;">Almuerzo</th>
              <th style="width:57px;">Cena</th>
              <th style="width:60px;">T. Urbano</th>
              <th style="width:60px;">T. Vereda</th>
              <th style="width:69px;">A. Adic ($)</th>
              <th style="width:69px;">A. Ganado ($)</th>
              <th style="width:80px;">Recaudo Neto</th>
              <th style="width:67px;">Préstamo</th>
              <th style="width:30px;"></th>
            </tr>
          </thead>
          <tbody id="tbody-afiliaciones">
            <!-- Cargado vía JS -->
          </tbody>
          <tfoot>
            <tr>
              <td colspan="3" style="text-align:left; padding-left:1rem; letter-spacing:0.05em;">TOTALES</td>
              <td id="tot-aff">0</td>
              <td id="tot-rec-abono">$0</td>
              <td id="tot-almuerzo">$0</td>
              <td id="tot-cena">$0</td>
              <td id="tot-urbano">$0</td>
              <td id="tot-vereda">$0</td>
              <td id="tot-abono-adic">$0</td>
              <td id="tot-abono-ganado">$0</td>
              <td id="tot-recaudo-neto">$0</td>
              <td id="tot-prestamo">$0</td>
              <td></td>
            </tr>
          </tfoot>
        </table>
      </div>
      <div class="table-footer-bar">
        <button class="btn btn-primary btn-agregar-asesor" onclick="agregarFilaAfiliacion()">+ Agregar Asesor</button>
      </div>
    </div>

  </div>

  <!-- ═══ PESTAÑA 2: CONTABILIDAD COORDINADOR ═══ -->
  <div id="tab-contabilidad" class="tab-content">

    <!-- Header para impresión página 2 -->
    <div class="print-header">
      <div class="header-card">
        <div class="header-main">
          <div class="header-top">
            <div class="brand-title">
              <h1 data-empresa-nombre>Óptica Angelus Visión</h1>
              <p>Sistema Operativo y Contable de Campo</p>
            </div>
          </div>
          <div class="meta-row">
            <div class="meta-field">
              <label>📅 Fecha Jornada</label>
              <input type="date" id="global-fecha-print" value="">
            </div>
            <div class="meta-field">
              <label>📍 Municipio</label>
              <input type="text" id="global-municipio-print" value="">
            </div>
            <div class="meta-field">
              <label>👤 Coordinador</label>
              <input type="text" id="global-coordinador-print" value="">
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="summary-cards">
      <div class="stat-card">
        <div class="sc-header">
          <div class="sc-icon">💼</div>
          <div class="label">Saldo Inicial Caja</div>
        </div>
        <div class="value" id="card-coor-saldo-init"></div>
      </div>
      <div class="stat-card">
        <div class="sc-header">
          <div class="sc-icon">📈</div>
          <div class="label">Total Ingresos</div>
        </div>
        <div class="value" id="card-coor-ingresos"></div>
      </div>
      <div class="stat-card">
        <div class="sc-header">
          <div class="sc-icon">📉</div>
          <div class="label">Total Egresos / Gastos</div>
        </div>
        <div class="value" id="card-coor-gastos"></div>
      </div>
      <div class="stat-card sc-navy summary-final-card">
        <div class="sc-summary-content">
          <div class="sc-header">
            <div class="sc-icon">🏦</div>
            <div class="label">Saldo Final a Rendir</div>
          </div>
          <div class="sc-formula">(Saldo Inicial + Ingresos) − Deducción − Egresos</div>
          <div class="sc-detail" id="balance-detalle"></div>
        </div>
        <div class="value" id="card-coor-saldo-final"></div>
        <div class="value" id="coor-saldo-final-big" style="display:none;"></div>
      </div>
    </div>

    <div class="coordinacion-grid">

      <!-- ── COLUMNA IZQUIERDA ── -->
      <div class="left-col">

        <!-- 1. INGRESOS -->
        <div class="section-card">
          <div class="section-header">
            <div class="section-header-left">
              <div class="section-badge">1</div>
              <span class="section-title-text">Ingresos y entradas de caja</span>
            </div>
          </div>

          <div class="form-row" style="background: var(--green-light);">
            <div class="form-row-label"><span class="row-icon">💵</span> Saldo Inicial en Caja</div>
            <div class="form-row-inputs">
              <input type="number" id="coor-saldo-inicial" value="" oninput="calcularContabilidad()" placeholder="Monto ($)" style="max-width:120px;">
              <input type="text" id="saldo-inicial-origen" value="" placeholder="Origen">
            </div>
          </div>

          <div class="form-row">
            <div class="form-row-label"><span class="row-icon">👥</span> Afiliaciones y Recaudo</div>
            <div class="form-row-inputs">
              <div class="input-group">
